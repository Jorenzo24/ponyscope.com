---
// Nav.astro
// Barre de navigation sticky : logo + liens catégories + search + CTA "S'abonner"
---

<nav class="nav" data-pagefind-ignore>
  <div class="nav-inner">
    <a href="/" class="logo" aria-label="Ponyscope — accueil">
      <span class="logo-mark">
        <img
          class="logo-icon"
          src="/logo-carre-ponyscope.jpg"
          alt=""
          width="36"
          height="36"
        />
        <span class="logo-word">Ponyscope</span>
      </span>
    </a>
    <ul class="nav-links">
      <li><a href="/blog">Blog</a></li>
      <li><a href="/tops">Tops</a></li>
      <li><a href="/tutos">Tutos</a></li>
      <li><a href="/guides-galops">Guides Galops</a></li>
      <li><a href="/metiers">Métiers</a></li>
      <li><a href="/ethologie">Éthologie</a></li>
    </ul>
    <div class="nav-actions">
      <button class="nav-search" data-open-search aria-label="Rechercher">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="7"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
      </button>
      {/* CTA "S'abonner" retiré tant que la page /newsletter n'existe pas
          (évite un lien 404). À réintroduire avec le composant Newsletter. */}
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    background: rgba(255, 252, 246, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    z-index: 100;
    padding: 22px 0;
  }
  .nav-inner {
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 40px;
  }
  .logo {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 28px;
    letter-spacing: -0.01em;
    color: var(--navy);
    text-decoration: none;
    justify-self: start;
  }
  .logo-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .logo-icon {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
    flex-shrink: 0;
  }
  .logo-word {
    line-height: 1;
  }
  .nav-links {
    display: flex;
    gap: 40px;
    list-style: none;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
    color: var(--ink-mid);
  }
  .nav-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
    padding: 4px 0;
  }
  .nav-links a:hover { color: var(--gold-deep); }

  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-search {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--navy);
    padding: 4px;
  }
  .nav-cta {
    background: var(--navy);
    color: var(--paper);
    padding: 11px 22px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    border: 1px solid var(--navy);
  }
  .nav-cta:hover {
    background: var(--paper);
    color: var(--navy);
  }

  @media (max-width: 768px) {
    .nav-inner {
      padding: 0 24px;
      gap: 0;
      grid-template-columns: 1fr auto;
    }
    .nav-links { display: none; }
    .nav-search { display: none; }
    .logo { font-size: 22px; }
    .logo-icon { width: 30px; height: 30px; }
    .nav-cta { padding: 9px 16px; font-size: 10px; }
  }
</style>
