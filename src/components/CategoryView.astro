---
// CategoryView.astro
// Page de catégorie — parti-pris "magazine premium" :
//   1. Hero compact navy (titre + chapô éditorial optionnel + compteur)
//   2. Rangée de liens vers les catégories sœurs (si sous-catégories)
//   3. "La Une" : l'article le plus récent mis en avant en grand format paysage
//   4. Barre de contrôles : filtre instantané (texte) + tri (récent/ancien/A–Z)
//   5. Grille numérotée façon sommaire (le reste des articles)
//   6. Pagination client (numérotée)
//
// Filtre, tri et pagination sont gérés CÔTÉ CLIENT en JS sur l'ensemble des
// cartes rendues au build (SSG pur : aucune requête runtime). Tous les liens
// d'articles sont donc présents dans le HTML (bon pour le crawl).
//
// Reçoit l'objet catégorie produit par getCategoryTree() :
//   { path, slug, name, articles, subcategories }

import CategoryCard from './CategoryCard.astro';
import OrnamentDivider from './OrnamentDivider.astro';
import { prettyCategoryName, mediaURL, getArticlePath } from '../lib/strapi.js';

export interface Props {
  category: {
    path: string;
    slug: string;
    name?: string;
    articles: any[];
    subcategories: string[];
  };
}

const { category } = Astro.props;
const name = category.name || prettyCategoryName(category.slug);
const count = category.articles.length;

// Année la plus ancienne de la rubrique (pour "depuis 20XX" sous le titre).
const years = category.articles
  .map((a) => {
    const r = a?.originalPublishedAt || a?.publishedAt;
    return r ? new Date(r).getFullYear() : null;
  })
  .filter((y): y is number => typeof y === 'number' && !Number.isNaN(y));
const earliestYear = years.length ? Math.min(...years) : null;

// --- Chapô éditorial par rubrique (OPTIONNEL) ---
// Petite ligne de présentation qui donne une âme à la rubrique. À personnaliser
// librement (clé = slug Strapi de la catégorie). Si absent → pas de chapô.
const CATEGORY_INTROS: Record<string, string> = {
  'tops-cheval': 'Le meilleur et le pire de la vie de cavalier, en listes.',
  'tutos-cheval': 'On retrousse les manches : le geste juste, expliqué simplement.',
  'guides-galops': 'Pour progresser, du premier galop au dernier obstacle.',
  'metiers-equestres': 'Celles et ceux qui font tourner le monde du cheval.',
  'ethologie': 'Comprendre le cheval avant de vouloir le monter.',
  // 'blog': '…',
};
const intro = CATEGORY_INTROS[category.slug] || '';

// Breadcrumbs : on découpe le path en segments
const segs = category.path.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const crumbs = segs.map((s, i) => ({
  label: prettyCategoryName(s),
  path: '/' + segs.slice(0, i + 1).join('/'),
  isLast: i === segs.length - 1,
}));

// Sous-catégories : nom + path
const subs = category.subcategories.map((p) => ({
  path: p,
  label: prettyCategoryName(p.split('/').filter(Boolean).pop() || ''),
}));

// "La Une" = l'article le plus récent (la liste arrive déjà triée date desc).
// Le reste alimente la grille.
const [featured, ...rest] = category.articles;

// Image fixe du hero par rubrique (à déposer dans public/heroes/). Tant qu'une
// rubrique n'a pas son image dédiée, on retombe sur la cover de l'article phare.
// Clé = slug Strapi de la catégorie.
const HERO_IMAGES: Record<string, string> = {
  // 'blog': '/heroes/blog.jpg',
  // 'tops-cheval': '/heroes/tops.jpg',
};
const heroBgURL =
  HERO_IMAGES[category.slug] || (featured ? featuredCover(featured) : undefined);

function formatDate(a: any): string {
  const raw = a?.originalPublishedAt || a?.publishedAt;
  if (!raw) return '';
  try {
    return new Date(raw).toLocaleDateString('fr-FR', {
      day: 'numeric', month: 'long', year: 'numeric',
    });
  } catch {
    return '';
  }
}

function featuredCover(a: any): string | undefined {
  const cover = a?.cover;
  if (!cover) return undefined;
  const candidate =
    cover.formats?.large?.url ||
    cover.formats?.medium?.url ||
    cover.url;
  return candidate ? mediaURL(candidate) : undefined;
}

// 13 = 1 feature (occupe 4 cellules) + 12 cartes normales = 16 cellules = 4
// rangées pleines en grille 4 colonnes (pas de trou en fin de grille).
const PAGE_SIZE = 13;
---

<header class="cat-hero">
  {heroBgURL && (
    <div class="cat-hero-bg" style={`background-image:url(${heroBgURL})`}></div>
  )}
  <div class="cat-hero-veil"></div>
  <div class="cat-hero-content">
    <nav class="cat-crumbs" aria-label="Fil d'ariane">
      <a href="/">Accueil</a>
      {crumbs.map((c) => (
        <>
          <span class="sep">·</span>
          {c.isLast ? (
            <span class="current">{c.label}</span>
          ) : (
            <a href={c.path}>{c.label}</a>
          )}
        </>
      ))}
    </nav>

    <p class="cat-kicker">Le magazine</p>

    <h1 class="cat-title">{name}</h1>

    {intro && <p class="cat-intro">{intro}</p>}

    <OrnamentDivider symbol="✦" width="56px" variant="gold-soft" marginY="0" />

    <p class="cat-count">
      {count} article{count > 1 ? 's' : ''}
      {earliestYear && <span class="cat-count-since"> · depuis {earliestYear}</span>}
    </p>

    {rest.length > 0 && (
      <div class="cat-hero-search">
        <span class="cat-hero-search-ico" aria-hidden="true">⌕</span>
        <input
          type="text"
          data-search
          placeholder="Rechercher un article…"
          aria-label="Filtrer les articles de cette rubrique"
          autocomplete="off"
        />
      </div>
    )}
  </div>
</header>

{subs.length > 0 && (
  <div class="cat-subs">
    <div class="cat-subs-inner">
      <a class="cat-sub cat-sub--all" href={category.path}>Tout {name}</a>
      {subs.map((s) => (
        <a class="cat-sub" href={s.path}>{s.label}</a>
      ))}
    </div>
  </div>
)}

<section
  class="cat-main"
  data-category
  data-page-size={PAGE_SIZE}
>
  {/* === La Une — article phare === */}
  {featured && (
    <a class="lune" href={getArticlePath(featured)} data-featured>
      <div class="lune-media">
        {featuredCover(featured) ? (
          <img src={featuredCover(featured)} alt={featured?.cover?.alternativeText || ''} />
        ) : (
          <div class="lune-media-empty" aria-hidden="true"></div>
        )}
      </div>
      <div class="lune-body">
        <span class="lune-kicker">À la une</span>
        <h2 class="lune-title" set:html={featured.title}></h2>
        {featured.excerpt && (
          <p class="lune-excerpt" set:html={featured.excerpt}></p>
        )}
        <div class="lune-meta">
          {formatDate(featured) && <time>{formatDate(featured)}</time>}
          <span class="lune-cta">Lire l'article →</span>
        </div>
      </div>
    </a>
  )}

  {/* === Contrôles : filtre + tri === */}
  {rest.length > 0 && (
    <div class="cat-controls">
      <span class="cat-result-count" data-count></span>
      <div class="cat-sort" role="group" aria-label="Trier les articles">
        <button type="button" data-sort="recent" class="is-active">Récent</button>
        <button type="button" data-sort="old">Ancien</button>
        <button type="button" data-sort="az">A–Z</button>
      </div>
    </div>
  )}

  {/* === Grille numérotée === */}
  <div class="cat-grid" data-grid>
    {rest.map((article) => (
      <CategoryCard article={article} />
    ))}
  </div>

  {/* État vide (filtre sans résultat) */}
  <p class="cat-empty" data-empty hidden>
    Aucun article ne correspond à votre recherche.
  </p>

  {/* Pagination (remplie par JS) */}
  <nav class="cat-pagination" data-pagination aria-label="Pagination"></nav>
</section>

<style>
  /* === Hero monumental — photo plein cadre, traitement chaud === */
  .cat-hero {
    position: relative;
    background: var(--navy-deep);
    color: var(--paper);
    padding: 132px 24px 104px;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  /* Photo : cover de l'article phare, vivante et réchauffée (sépia léger),
     assombrie pour la lisibilité du titre. Léger flou = lisse le ~760px source. */
  .cat-hero-bg {
    position: absolute;
    inset: -10px;
    z-index: -2;
    background-size: cover;
    background-position: center;
    filter: brightness(0.62) saturate(1.08) sepia(0.18) contrast(1.02) blur(3px);
    transform: scale(1.05);
  }
  /* Voile CHAUD : dégradé espresso (et non bleu froid) + vignette + grain. */
  .cat-hero-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 120% 90% at center, transparent 0%, rgba(28, 18, 10, 0.52) 100%),
      linear-gradient(to bottom, rgba(28, 18, 10, 0.5) 0%, rgba(28, 18, 10, 0.12) 35%, rgba(20, 13, 8, 0.78) 100%),
      repeating-linear-gradient(100deg, rgba(255, 255, 255, 0.015) 0 1px, transparent 1px 3px);
    pointer-events: none;
  }
  .cat-hero-content {
    position: relative;
    z-index: 1;
    max-width: 940px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  /* Overline éditorial */
  .cat-kicker {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    color: var(--gold-soft);
    margin: 4px 0 -6px;
    text-indent: 0.42em;        /* compense le letter-spacing pour rester centré */
  }

  .cat-crumbs {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: rgba(250, 246, 238, 0.6);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .cat-crumbs a { color: rgba(250, 246, 238, 0.78); text-decoration: none; transition: color 0.2s; }
  .cat-crumbs a:hover { color: var(--gold-soft); }
  .cat-crumbs .sep { color: var(--gold); }
  .cat-crumbs .current { color: var(--gold-soft); }

  .cat-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(58px, 8.5vw, 124px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--paper);
    margin: 0;
    text-shadow: 0 2px 36px rgba(20, 13, 8, 0.5);
  }
  .cat-title :global(em) { font-style: italic; color: var(--gold-soft); }

  .cat-intro {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.4;
    color: rgba(250, 246, 238, 0.85);
    max-width: 600px;
    margin: -4px 0 0;
  }

  .cat-count {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    color: rgba(250, 246, 238, 0.62);
    margin: 0;
    letter-spacing: 0.02em;
  }
  .cat-count-since { color: var(--gold-soft); }

  /* === Rangée des sous-catégories === */
  .cat-subs {
    background: var(--ivory-warm);
    border-bottom: 1px solid rgba(191, 155, 102, 0.28);
  }
  .cat-subs-inner {
    max-width: 1480px;
    margin: 0 auto;
    padding: 20px 32px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 32px;
  }
  .cat-sub {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--ink-mid);
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s;
    border-bottom: none;
  }
  .cat-sub:hover { color: var(--gold-deep); }
  .cat-sub--all { color: var(--gold-deep); font-weight: 600; }

  /* === Conteneur principal sur fond ivoire === */
  .cat-main {
    background: var(--ivory);
    padding: 80px 32px 100px;
  }
  .cat-main > * {
    max-width: 1480px;
    margin-left: auto;
    margin-right: auto;
  }

  /* === La Une — article phare === */
  .lune {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    gap: 0;
    background: var(--paper);
    text-decoration: none;
    color: inherit;
    border-bottom: none;
    box-shadow: 0 1px 0 rgba(74, 54, 30, 0.05), 0 40px 80px -50px rgba(74, 54, 30, 0.34);
    margin-bottom: 80px;
    overflow: hidden;
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }
  .lune:hover {
    box-shadow: 0 1px 0 rgba(74, 54, 30, 0.05), 0 50px 90px -46px rgba(74, 54, 30, 0.42);
    transform: translateY(-3px);
  }
  .lune-media {
    position: relative;
    overflow: hidden;
    background: var(--ivory-warm);
    min-height: 420px;
  }
  .lune-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
    filter: saturate(1.06) contrast(1.02) brightness(1.02);
  }
  .lune:hover .lune-media img { transform: scale(1.04); }
  .lune-media-empty {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--ivory-warm), var(--ivory));
  }
  .lune-body {
    padding: 56px 56px 52px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .lune-kicker {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.36em;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 22px;
  }
  .lune-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--navy);
    margin: 0 0 20px;
    transition: color 0.2s;
  }
  .lune-title :global(em) { font-style: italic; }
  .lune:hover .lune-title { color: var(--gold-deep); }
  .lune-excerpt {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-mid);
    margin: 0 0 28px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lune-excerpt :global(em) { font-style: italic; }
  .lune-meta {
    display: flex;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .lune-cta {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gold-deep);
    font-weight: 600;
  }

  /* === Barre de contrôles === */
  .cat-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding-bottom: 30px;
    margin-bottom: 50px;
    border-bottom: 1px solid rgba(16, 20, 47, 0.1);
  }
  /* Recherche stylisée dans le hero (pilule verre dépoli, accent or) */
  .cat-hero-search {
    position: relative;
    width: min(560px, 100%);
    margin: 18px auto 0;
  }
  .cat-hero-search-ico {
    position: absolute;
    left: 24px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 21px;
    color: var(--gold-soft);
    pointer-events: none;
  }
  .cat-hero-search input {
    width: 100%;
    border: 1px solid rgba(212, 185, 136, 0.45);
    background: rgba(20, 13, 8, 0.32);
    border-radius: 999px;
    padding: 17px 26px 17px 56px;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--paper);
    letter-spacing: 0.015em;
    text-align: left;
    backdrop-filter: blur(10px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 14px 34px -20px rgba(0, 0, 0, 0.7);
    transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;
    -webkit-appearance: none;
    appearance: none;
  }
  .cat-hero-search input::placeholder {
    color: rgba(250, 246, 238, 0.66);
    opacity: 1;
  }
  .cat-hero-search input:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(20, 13, 8, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 0 4px rgba(191, 155, 102, 0.16),
      0 14px 34px -20px rgba(0, 0, 0, 0.7);
  }

  .cat-result-count {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
  }
  .cat-sort {
    display: flex;
    gap: 4px;
  }
  .cat-sort button {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    background: none;
    border: none;
    padding: 8px 14px;
    cursor: pointer;
    position: relative;
    transition: color 0.2s;
  }
  .cat-sort button::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 2px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform 0.25s ease;
  }
  .cat-sort button:hover { color: var(--navy); }
  .cat-sort button.is-active { color: var(--navy); }
  .cat-sort button.is-active::after { transform: scaleX(1); }

  /* === Grille d'articles (4 colonnes desktop) === */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 50px 36px;
    align-items: start;
    grid-auto-flow: row dense;
  }

  .cat-empty {
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--ink-soft);
    padding: 40px 0;
  }

  /* === Pagination éditoriale === */
  .cat-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 88px;
    padding-top: 40px;
    border-top: 1px solid rgba(191, 155, 102, 0.22);
  }
  .cat-pagination:empty { display: none; }
  /* Boutons créés en JS → sélecteurs :global() pour échapper au scope Astro. */
  .cat-pagination :global(button) {
    -webkit-appearance: none;
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    color: var(--ink-mid);
    background: none;
    border: 1px solid rgba(191, 155, 102, 0.32);
    border-radius: 50%;
    width: 46px;
    height: 46px;
    min-width: 46px;
    padding: 0;
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .cat-pagination :global(button:hover:not(:disabled):not(.is-active)) {
    color: var(--navy);
    border-color: var(--gold);
  }
  .cat-pagination :global(button.is-active) {
    color: var(--paper);
    background: var(--gold);
    border-color: var(--gold);
  }
  /* Flèches préc./suiv. (1er et dernier bouton) */
  .cat-pagination :global(button:first-child),
  .cat-pagination :global(button:last-child) {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 15px;
    color: var(--gold-deep);
  }
  .cat-pagination :global(button:first-child:hover:not(:disabled)),
  .cat-pagination :global(button:last-child:hover:not(:disabled)) {
    color: var(--paper);
    background: var(--gold);
    border-color: var(--gold);
  }
  .cat-pagination :global(button:disabled) { opacity: 0.28; cursor: default; }
  .cat-pagination :global(.pg-ellipsis) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    color: var(--ink-soft);
    padding: 0 4px;
    user-select: none;
  }

  /* === Animation d'apparition (progressive enhancement) === */
  [data-category].js-ready :global([data-card]),
  [data-category].js-ready .lune {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  [data-category].js-ready :global([data-card].is-in),
  [data-category].js-ready .lune.is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-category].js-ready :global([data-card]),
    [data-category].js-ready .lune {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* === Responsive === */
  @media (max-width: 1280px) {
    .cat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 50px 36px; }
  }
  @media (max-width: 980px) {
    .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 32px; }
  }
  @media (max-width: 860px) {
    .lune { grid-template-columns: 1fr; }
    .lune-media { min-height: 280px; aspect-ratio: 16 / 10; }
    .lune-body { padding: 36px 32px 38px; }
  }
  @media (max-width: 640px) {
    .cat-hero { padding: 78px 20px 60px; }
    .cat-hero-content { gap: 18px; }
    .cat-kicker { letter-spacing: 0.34em; text-indent: 0.34em; }
    .cat-title { font-size: clamp(42px, 13vw, 72px); }
    .cat-subs-inner { padding: 16px 20px; gap: 6px 22px; }
    .cat-sub { font-size: 10px; letter-spacing: 0.22em; }
    .cat-main { padding: 50px 16px 64px; }
    .lune { margin-bottom: 56px; }
    .cat-controls { gap: 18px; }
    .cat-grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>

<script>
  // Filtre + tri + pagination + animation, 100% client, scopés à la page.
  (() => {
    const root = document.querySelector<HTMLElement>('[data-category]');
    if (!root) return;

    const grid = root.querySelector<HTMLElement>('[data-grid]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    // La recherche vit dans le hero (hors du root) → sélection globale.
    const searchInput = document.querySelector<HTMLInputElement>('[data-search]');
    const sortBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sort]'));
    const pagination = root.querySelector<HTMLElement>('[data-pagination]');
    const emptyMsg = root.querySelector<HTMLElement>('[data-empty]');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const featured = root.querySelector<HTMLElement>('[data-featured]');
    const PAGE_SIZE = parseInt(root.dataset.pageSize || '9', 10) || 9;

    if (!grid || cards.length === 0) {
      // Pas de grille : on anime juste la Une et on sort.
      root.classList.add('js-ready');
      requestAnimationFrame(() => featured?.classList.add('is-in'));
      return;
    }

    root.classList.add('js-ready');

    let query = '';
    let sort: 'recent' | 'old' | 'az' = 'recent';
    let page = 1;

    const norm = (s: string) =>
      s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

    function getVisible(): HTMLElement[] {
      const q = norm(query);
      let list = cards.filter((c) =>
        q === '' ? true : norm(c.dataset.title || '').includes(q)
      );
      list.sort((a, b) => {
        if (sort === 'az') {
          return (a.dataset.title || '').localeCompare(b.dataset.title || '', 'fr');
        }
        const da = Number(a.dataset.date || 0);
        const db = Number(b.dataset.date || 0);
        return sort === 'old' ? da - db : db - da;
      });
      return list;
    }

    function buildPagination(totalPages: number) {
      if (!pagination) return;
      pagination.innerHTML = '';
      if (totalPages <= 1) return;

      const mkBtn = (label: string, target: number, opts: { active?: boolean; disabled?: boolean } = {}) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        if (opts.active) b.classList.add('is-active');
        if (opts.disabled) b.disabled = true;
        if (!opts.disabled && !opts.active) {
          b.addEventListener('click', () => { page = target; render(true); });
        }
        return b;
      };
      const mkEllipsis = () => {
        const s = document.createElement('span');
        s.className = 'pg-ellipsis';
        s.textContent = '…';
        return s;
      };

      pagination.appendChild(mkBtn('‹', page - 1, { disabled: page === 1 }));

      // Fenêtre de pages : 1 … (p-1 p p+1) … N
      const pages = new Set<number>([1, totalPages, page, page - 1, page + 1]);
      const sorted = [...pages].filter((p) => p >= 1 && p <= totalPages).sort((a, b) => a - b);
      let prev = 0;
      for (const p of sorted) {
        if (p - prev > 1) pagination.appendChild(mkEllipsis());
        pagination.appendChild(mkBtn(String(p), p, { active: p === page }));
        prev = p;
      }

      pagination.appendChild(mkBtn('›', page + 1, { disabled: page === totalPages }));
    }

    function render(scroll = false) {
      const visible = getVisible();
      const totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
      if (page > totalPages) page = totalPages;
      if (page < 1) page = 1;

      const start = (page - 1) * PAGE_SIZE;
      const pageCards = visible.slice(start, start + PAGE_SIZE);
      const pageSet = new Set(pageCards);

      // Ordre du DOM = ordre trié (pour que la grille suive le tri)
      visible.forEach((c) => grid!.appendChild(c));

      cards.forEach((c) => {
        const show = pageSet.has(c);
        c.style.display = show ? '' : 'none';
        c.classList.remove('is-in');
        c.classList.remove('card--feature');
      });

      // Position(s) mise(s) en gros (bloc 2×2) pour casser la grille. Le flux
      // dense de la grille fait remonter les autres cartes pour combler.
      const FEATURE_POS = new Set([0]);

      // Mise en avant "feature" — seulement si assez de cartes sur la page pour
      // entourer proprement le bloc 2×2 (sinon grille plate, petites rubriques).
      const enableFeature = pageCards.length >= 8;
      pageCards.forEach((c, i) => {
        if (enableFeature && FEATURE_POS.has(i)) c.classList.add('card--feature');
      });

      if (emptyMsg) emptyMsg.hidden = visible.length > 0;

      if (countEl) {
        const n = visible.length;
        const plural = n > 1 ? 's' : '';
        countEl.textContent = norm(query)
          ? `${n} résultat${plural}`
          : `${n} article${plural}`;
      }

      buildPagination(totalPages);

      // Apparition en cascade
      requestAnimationFrame(() => {
        pageCards.forEach((c, i) => {
          c.style.transitionDelay = Math.min(i, 8) * 45 + 'ms';
          c.classList.add('is-in');
        });
      });

      if (scroll) {
        root!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // --- Listeners ---
    let debounce: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => {
        query = searchInput.value;
        page = 1;
        // On masque la Une pendant une recherche active (elle n'est plus pertinente)
        if (featured) featured.style.display = norm(query) ? 'none' : '';
        render();
      }, 140);
    });

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sortBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        sort = (btn.dataset.sort as typeof sort) || 'recent';
        page = 1;
        render();
      });
    });

    // Première peinture
    requestAnimationFrame(() => featured?.classList.add('is-in'));
    render();
  })();
</script>
