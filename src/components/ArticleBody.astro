---
// ArticleBody.astro
// Wrap autour du contenu d'article : largeur 860px, encadrement paper,
// drop cap gold sur 1er paragraphe, rule décorative avant chaque h2.
// Le contenu (issu de BlocksRenderer) passe via le slot.

export interface Props {
  excerpt?: string;        // Chapô / lede (paragraphe d'intro stylisé)
}

const { excerpt } = Astro.props;
---

<div class="article-wrap">
  <div class="article">
    <article class="article-main">
      {excerpt && <p class="lede" set:html={excerpt}></p>}
      <div class="article-content">
        <slot />
      </div>
    </article>
  </div>
</div>

<style>
  .article-wrap {
    background-color: var(--paper);
    position: relative;
  }
  .article {
    max-width: 1480px;
    margin: 0 auto;
    padding: 120px 48px 100px;
  }
  .article-main {
    max-width: 860px;
    margin: 0 auto;
    background-color: var(--paper);
    border: 1px solid var(--line);
    padding: 70px 72px;
  }

  /* Chapô / lede */
  .lede {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.45;
    color: var(--navy);
    margin-bottom: 80px;
    padding-bottom: 60px;
    border-bottom: 1px solid var(--line);
    letter-spacing: -0.01em;
  }
  .lede::first-letter {
    font-family: var(--font-serif);
    font-size: 4.5em;
    float: left;
    line-height: 0.82;
    padding: 8px 14px 0 0;
    font-weight: 400;
    color: var(--gold);
    font-style: italic;
  }

  /* Styles globaux pour le contenu rendu par BlocksRenderer */
  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 38px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 80px 0 32px;
    color: var(--navy);
  }
  .article-content :global(h2 em) { font-style: italic; }
  /* Rule décorative gold avant chaque h2 */
  .article-content :global(h2)::before {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin-bottom: 28px;
  }

  .article-content :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 48px 0 20px;
    color: var(--navy);
  }

  .article-content :global(p) {
    margin-bottom: 24px;
    font-size: 18px;
    line-height: 1.8;
    color: var(--ink-mid);
    font-weight: 400;
  }
  .article-content :global(p:last-child) { margin-bottom: 0; }

  .article-content :global(a) {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 1px;
    transition: all 0.2s;
  }
  .article-content :global(a:hover) {
    color: var(--gold-deep);
    border-bottom-color: var(--gold-deep);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 24px 24px;
    font-size: 18px;
    line-height: 1.8;
    color: var(--ink-mid);
  }
  .article-content :global(li) {
    margin-bottom: 8px;
  }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding: 8px 0 8px 32px;
    margin: 48px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    line-height: 1.5;
    color: var(--navy);
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 48px 0;
  }

  .article-content :global(figure) {
    margin: 64px 0;
  }
  .article-content :global(figcaption) {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-soft);
    margin-top: 20px;
    text-align: center;
    font-weight: 500;
  }

  /* Embeds vidéo */
  .article-content :global(.video-embed) {
    margin: 48px 0;
    aspect-ratio: 16/9;
  }
  .article-content :global(.video-embed iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 768px) {
    .article { padding: 60px 24px; }
    .article-main { padding: 40px 24px; }
    .article-content :global(h2) {
      font-size: 28px;
      margin-top: 60px;
    }
    .lede {
      font-size: 22px;
      margin-bottom: 60px;
      padding-bottom: 40px;
    }
  }
</style>
