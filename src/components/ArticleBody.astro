---
// ArticleBody.astro
// Mise en page magazine 3 colonnes :
//   - Sidebar gauche : sommaire (TOC) sticky
//   - Centre : carte papier blanche (paper) avec l'article
//   - Sidebar droite : encart auteur + articles liés
//
// Le wrap global est en cream (ivory) pour faire ressortir la carte papier
// du centre comme une page de magazine posée sur une table.
// En dessous de la grille : un emplacement publicitaire "découverte"
// centré sur toute la largeur disponible.

import ArticleTOC from './ArticleTOC.astro';
import ArticleAuthor from './ArticleAuthor.astro';
import ArticleRelated from './ArticleRelated.astro';
import AdSlot from './AdSlot.astro';
import OrnamentDivider from './OrnamentDivider.astro';

export interface Props {
  excerpt?: string;
  cover?: string;
  coverAlt?: string;
  coverCaption?: string;
  headings?: Array<{ level: number; text: string; id: string }>;
  author?: {
    name?: string;
    role?: string;
    bio?: string;
    avatarURL?: string;
    href?: string;
  };
  related?: any[];
}

const {
  excerpt,
  cover,
  coverAlt = '',
  coverCaption,
  headings = [],
  author,
  related = [],
} = Astro.props;
---

<div class="article-wrap">
  <div class="article-shell">
    <div class="article-grid">

      {/* === Sidebar gauche : sommaire === */}
      <div class="article-toc-zone">
        <ArticleTOC headings={headings} />
      </div>

      {/* === Colonne centrale : carte paper === */}
      <main class="article-main">

        {excerpt && (
          <p class="lede" set:html={excerpt}></p>
        )}

        {cover && (
          <figure class="article-cover">
            <img
              src={cover}
              alt={coverAlt}
              loading="eager"
              fetchpriority="high"
            />
            {coverCaption && <figcaption set:html={coverCaption}></figcaption>}
          </figure>
        )}

        <AdSlot
          label="En partenariat avec"
          variant="sponsor"
          id="ad-sponsor"
          minHeight="160px"
        />

        <div class="article-content">
          <slot />
        </div>

        <div class="article-ornament">
          <OrnamentDivider symbol="✦" width="40px" variant="gold" marginY="0" />
        </div>

      </main>

      {/* === Sidebar droite : auteur + articles liés === */}
      <aside class="article-aside">
        {author && author.name && <ArticleAuthor {...author} />}
        {related.length > 0 && <ArticleRelated articles={related} />}
      </aside>

    </div>

    {/* === Pub "découverte" sous toute la grille === */}
    <div class="article-bottom">
      <AdSlot
        label="À découvrir"
        variant="discovery"
        id="ad-discovery"
        minHeight="240px"
      />
    </div>

  </div>
</div>

<style>
  /* === Wrap ivoire (cream) + shell centré === */
  .article-wrap {
    background: var(--ivory);
    position: relative;
  }
  .article-shell {
    max-width: 1480px;
    margin: 0 auto;
    /* padding-top: 0 → la carte paper du centre colle au hero (cohérent
       avec l'idée magazine où la "page" commence là où la couverture finit) */
    padding: 0 48px 60px;
  }

  /* === Grille 3 colonnes ===
     TOC 220px | Article 760px | Aside 280px | gap 60px
     Total ~1380px, ça respire dans 1480 - 96 = 1384 ✓ */
  .article-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 760px) 280px;
    gap: 60px;
    justify-content: center;
    align-items: start;
  }

  .article-toc-zone {
    align-self: start;
  }

  .article-aside {
    align-self: start;
  }

  /* === Carte paper centrale === */
  .article-main {
    background: var(--paper);
    padding: 80px;
    box-shadow:
      0 1px 0 rgba(16, 20, 47, 0.04),
      0 30px 80px -40px rgba(16, 20, 47, 0.18);
  }

  /* === Chapô (drop cap gold italique) === */
  .lede {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.42;
    color: var(--navy);
    letter-spacing: -0.012em;
    margin-bottom: 60px;
  }
  .lede::first-letter {
    font-family: var(--font-serif);
    font-size: 4.6em;
    float: left;
    line-height: 0.82;
    padding: 8px 14px 0 0;
    font-weight: 400;
    color: var(--gold);
    font-style: italic;
  }

  /* === Image de couverture dans le flow === */
  .article-cover {
    margin: 0 0 60px;
    text-align: center;
  }
  .article-cover img {
    max-width: 100%;
    width: auto;
    height: auto;
    display: block;
    margin: 0 auto;
    box-shadow: 0 30px 60px -30px rgba(16, 20, 47, 0.35);
  }
  .article-cover figcaption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 18px;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  /* === Ornement en fin de contenu === */
  .article-ornament {
    margin-top: 80px;
    display: flex;
    justify-content: center;
  }

  /* === Styles globaux du contenu (BlocksRenderer) === */
  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.18;
    letter-spacing: -0.018em;
    margin: 70px 0 24px;
    color: var(--navy);
    scroll-margin-top: 100px;
  }
  .article-content :global(h2 em) { font-style: italic; }
  .article-content :global(h2)::before {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin-bottom: 24px;
  }

  .article-content :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 44px 0 16px;
    color: var(--navy);
    scroll-margin-top: 100px;
  }

  .article-content :global(p) {
    margin-bottom: 24px;
    font-size: 18px;
    line-height: 1.82;
    color: var(--ink-mid);
    font-weight: 400;
  }
  .article-content :global(p:last-child) { margin-bottom: 0; }

  .article-content :global(a) {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 1px;
    transition: all 0.2s;
  }
  .article-content :global(a:hover) {
    color: var(--gold-deep);
    border-bottom-color: var(--gold-deep);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 24px 24px;
    font-size: 18px;
    line-height: 1.82;
    color: var(--ink-mid);
  }
  .article-content :global(li) { margin-bottom: 8px; }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding: 8px 0 8px 32px;
    margin: 44px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    line-height: 1.45;
    color: var(--navy);
    letter-spacing: -0.005em;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 44px auto;
  }
  .article-content :global(figure) {
    margin: 56px 0;
  }
  .article-content :global(figcaption) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 14px;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .article-content :global(.video-embed) {
    margin: 44px 0;
    aspect-ratio: 16/9;
  }
  .article-content :global(.video-embed iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* === Pub découverte sous la grille === */
  .article-bottom {
    margin-top: 80px;
  }

  /* === Responsive : tablet et mobile === */
  @media (max-width: 1100px) {
    .article-shell {
      padding: 0 32px 40px;
    }
    .article-grid {
      grid-template-columns: minmax(0, 760px);
    }
    .article-toc-zone {
      display: none;
    }
    .article-aside {
      margin-top: 60px;
    }
    .article-main {
      padding: 60px 48px;
    }
  }

  @media (max-width: 768px) {
    .article-shell {
      padding: 0 12px 30px;
    }
    .article-main {
      padding: 40px 24px;
    }
    .lede {
      font-size: 22px;
      margin-bottom: 44px;
    }
    .lede::first-letter {
      font-size: 4em;
      padding-right: 12px;
    }
    .article-cover { margin-bottom: 44px; }
    .article-cover figcaption { font-size: 12px; margin-top: 14px; }
    .article-content :global(h2) {
      font-size: 26px;
      margin-top: 50px;
    }
    .article-content :global(h2)::before { margin-bottom: 16px; }
    .article-content :global(blockquote) {
      font-size: 19px;
      padding-left: 20px;
      margin: 32px 0;
    }
    .article-bottom {
      margin-top: 60px;
    }
  }
</style>
