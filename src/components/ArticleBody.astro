---
// ArticleBody.astro
// Corps de l'article : chapô, image de couverture dans le flow, contenu,
// et deux emplacements publicitaires éditoriaux (sponsor en haut, découverte en bas).
//
// Layout : chaque "zone" est centrée à 860px max sur fond ivoire,
// avec marges généreuses et aucune frame (style Cereal / Hermès).

import AdSlot from './AdSlot.astro';
import OrnamentDivider from './OrnamentDivider.astro';

export interface Props {
  excerpt?: string;
  cover?: string;
  coverAlt?: string;
  coverCaption?: string;
}

const { excerpt, cover, coverAlt = '', coverCaption } = Astro.props;
---

<div class="article-wrap">
  <article class="article">

    {/* === Chapô / lede === */}
    {excerpt && (
      <section class="zone zone--lede">
        <p class="lede" set:html={excerpt}></p>
      </section>
    )}

    {/* === Image de couverture dans le flow (taille native, pas étirée) === */}
    {cover && (
      <figure class="zone zone--cover">
        <img
          src={cover}
          alt={coverAlt}
          loading="eager"
          fetchpriority="high"
        />
        {coverCaption && <figcaption set:html={coverCaption}></figcaption>}
      </figure>
    )}

    {/* === Emplacement pub n°1 : "Présenté par" === */}
    <AdSlot
      label="En partenariat avec"
      variant="sponsor"
      id="ad-sponsor"
      minHeight="160px"
    />

    {/* === Contenu de l'article === */}
    <section class="zone zone--content">
      <div class="article-content">
        <slot />
      </div>
    </section>

    {/* === Ornement de fin de lecture === */}
    <div class="zone zone--ornament">
      <OrnamentDivider symbol="✦" width="40px" variant="gold" marginY="0" />
    </div>

    {/* === Emplacement pub n°2 : "Découverte" === */}
    <AdSlot
      label="À découvrir"
      variant="discovery"
      id="ad-discovery"
      minHeight="240px"
    />

  </article>
</div>

<style>
  /* === Wrapper global, fond papier === */
  .article-wrap {
    background-color: var(--paper);
    position: relative;
  }
  .article {
    max-width: 1480px;
    margin: 0 auto;
    padding: 120px 48px 100px;
  }

  /* Toutes les "zones" partagent la même largeur max et centrage */
  .zone {
    max-width: 860px;
    margin: 0 auto;
  }

  /* === Chapô / lede === */
  .zone--lede {
    margin-bottom: 80px;
  }
  .lede {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.42;
    color: var(--navy);
    letter-spacing: -0.012em;
    text-align: left;
  }
  .lede::first-letter {
    font-family: var(--font-serif);
    font-size: 5em;
    float: left;
    line-height: 0.82;
    padding: 8px 16px 0 0;
    font-weight: 400;
    color: var(--gold);
    font-style: italic;
  }

  /* === Cover image dans le flow === */
  .zone--cover {
    margin: 0 auto 80px;
    text-align: center;
  }
  .zone--cover img {
    max-width: 100%;
    width: auto;
    height: auto;
    display: block;
    margin: 0 auto;
    box-shadow: 0 30px 60px -30px rgba(16, 20, 47, 0.35);
  }
  .zone--cover figcaption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 22px;
    line-height: 1.5;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: 0.01em;
  }

  /* === Ornement de fin === */
  .zone--ornament {
    margin: 80px auto 0;
    display: flex;
    justify-content: center;
  }

  /* === Contenu (BlocksRenderer) === */
  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.15;
    letter-spacing: -0.018em;
    margin: 80px 0 28px;
    color: var(--navy);
  }
  .article-content :global(h2 em) { font-style: italic; }
  .article-content :global(h2)::before {
    content: '';
    display: block;
    width: 40px;
    height: 1px;
    background: var(--gold);
    margin-bottom: 28px;
  }

  .article-content :global(h3) {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 26px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 48px 0 18px;
    color: var(--navy);
  }

  .article-content :global(p) {
    margin-bottom: 26px;
    font-size: 18px;
    line-height: 1.82;
    color: var(--ink-mid);
    font-weight: 400;
  }
  .article-content :global(p:last-child) { margin-bottom: 0; }

  .article-content :global(a) {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding-bottom: 1px;
    transition: all 0.2s;
  }
  .article-content :global(a:hover) {
    color: var(--gold-deep);
    border-bottom-color: var(--gold-deep);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 26px 24px;
    font-size: 18px;
    line-height: 1.82;
    color: var(--ink-mid);
  }
  .article-content :global(li) { margin-bottom: 8px; }

  .article-content :global(blockquote) {
    border-left: 3px solid var(--gold);
    padding: 8px 0 8px 32px;
    margin: 48px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 26px;
    line-height: 1.45;
    color: var(--navy);
    letter-spacing: -0.005em;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 48px auto;
  }
  .article-content :global(figure) {
    margin: 64px 0;
  }
  .article-content :global(figcaption) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 16px;
    text-align: center;
    letter-spacing: 0.01em;
  }

  /* Embeds vidéo */
  .article-content :global(.video-embed) {
    margin: 48px 0;
    aspect-ratio: 16/9;
  }
  .article-content :global(.video-embed iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 768px) {
    .article { padding: 60px 24px 80px; }
    .lede { font-size: 22px; }
    .lede::first-letter { font-size: 4em; padding-right: 12px; }
    .zone--lede { margin-bottom: 60px; }
    .zone--cover { margin: 0 auto 60px; }
    .zone--cover figcaption { font-size: 13px; margin-top: 16px; }
    .article-content :global(h2) {
      font-size: 30px;
      margin-top: 60px;
    }
    .article-content :global(blockquote) {
      font-size: 20px;
      padding-left: 20px;
    }
  }
</style>
