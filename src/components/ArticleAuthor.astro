---
// ArticleAuthor.astro
// Boîte rédacteur en sidebar gauche, design "frontispice vertical" :
//   - Avatar circulaire 112px avec liseré blanc + ombre stratifiée (cohérence
//     avec le traitement des images d'article).
//   - Filet or + petite étoile (✦) en séparateur décoratif.
//   - Eyebrow gold uppercase "RÉDACTEUR" (ou rôle passé en prop).
//   - Nom italique Cormorant en gros, centré.
//
// Contenu volontairement minimal (pas de bio) — la richesse est dans la
// composition visuelle. Position sticky pour suivre la lecture.
//
// L'avatarURL doit être déjà absolu (résolu par le parent via mediaURL).

export interface Props {
  name?: string;
  role?: string;
  bio?: string;          // 1 phrase courte/punchline ajoutée dans Strapi
  avatarURL?: string;
  href?: string;
}

const {
  name,
  role = 'Rédacteur',
  bio,
  avatarURL,
  href,
} = Astro.props;

const visible = Boolean(name);

// Initiales pour le fallback si pas d'avatar
const initials = (name || '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((s) => s[0]?.toUpperCase() || '')
  .join('');
---

{visible && (
  <aside class="author-card" aria-label={`Rédacteur : ${name}`}>
    <div class="author-portrait">
      {avatarURL ? (
        <img class="author-avatar" src={avatarURL} alt={name} loading="lazy" />
      ) : (
        <div class="author-avatar author-avatar--placeholder" aria-hidden="true">
          {initials}
        </div>
      )}
    </div>

    <div class="author-content">
      <div class="author-eyebrow">{role}</div>

      {href ? (
        <a class="author-name" href={href}>{name}</a>
      ) : (
        <span class="author-name">{name}</span>
      )}

      {bio && <p class="author-bio" set:html={bio}></p>}
    </div>
  </aside>
)}

<style>
  /* === Carte rédacteur : fond navy + layout horizontal (avatar | contenu) ===
     Marge-top pour se détacher du hero (qui est lui aussi navy → la séparation
     se fait par le radius + l'ombre, pas par contraste de couleur). */
  .author-card {
    margin-top: 36px;
    padding: 18px 18px;
    background: var(--navy);
    border: 1px solid rgba(191, 155, 102, 0.35);
    border-radius: 8px;
    color: var(--paper);
    box-shadow: 0 10px 28px -18px rgba(16, 20, 47, 0.40);
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* === Avatar = vignette ronde encadrée blanc + ring or === */
  .author-portrait {
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    padding: 4px;
    background: #FFFFFF;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px rgba(191, 155, 102, 0.6),
      0 6px 14px -6px rgba(0, 0, 0, 0.35);
  }

  .author-avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    background: var(--ivory-warm);
    filter: saturate(0.9) sepia(0.06) contrast(1.03);
  }
  .author-avatar--placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    color: var(--gold-deep);
    border: 1px solid var(--gold-soft);
    filter: none;
    background: var(--paper);
  }

  /* === Contenu à droite de l'avatar === */
  .author-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* === Eyebrow gold uppercase === */
  .author-eyebrow {
    font-family: var(--font-sans);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.30em;
    color: var(--gold-soft);
    font-weight: 600;
  }

  /* === Nom italique Cormorant === */
  .author-name {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.2;
    color: var(--paper);
    text-decoration: none;
    border: none;
    letter-spacing: -0.005em;
  }
  a.author-name { transition: color 0.2s; }
  a.author-name:hover { color: var(--gold-soft); }

  /* === Bio = phrase courte / punchline ===
     Sous le nom, en italique paper opacité réduite. Guillemets gold en
     pseudo-éléments. */
  .author-bio {
    margin: 6px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13px;
    line-height: 1.4;
    color: rgba(250, 246, 238, 0.72);
    letter-spacing: 0.005em;
  }
  .author-bio::before {
    content: '« ';
    color: var(--gold);
    font-style: normal;
    font-weight: 500;
  }
  .author-bio::after {
    content: ' »';
    color: var(--gold);
    font-style: normal;
    font-weight: 500;
  }
  .author-bio :global(em) { font-style: normal; }

  /* En dessous de 1100px : la card passe en flow mobile sous l'article. */
  @media (max-width: 1100px) {
    .author-card {
      max-width: 460px;
      margin: 0 auto;
      padding: 22px 20px;
    }
    .author-portrait {
      flex: 0 0 76px;
      width: 76px;
      height: 76px;
    }
    .author-name { font-size: 19px; }
    .author-bio { font-size: 14px; }
  }
</style>
