---
// ArticleAuthor.astro
// Boîte rédacteur en sidebar gauche, design "frontispice vertical" :
//   - Avatar circulaire 112px avec liseré blanc + ombre stratifiée (cohérence
//     avec le traitement des images d'article).
//   - Filet or + petite étoile (✦) en séparateur décoratif.
//   - Eyebrow gold uppercase "RÉDACTEUR" (ou rôle passé en prop).
//   - Nom italique Cormorant en gros, centré.
//
// Contenu volontairement minimal (pas de bio) — la richesse est dans la
// composition visuelle. Position sticky pour suivre la lecture.
//
// L'avatarURL doit être déjà absolu (résolu par le parent via mediaURL).

export interface Props {
  name?: string;
  role?: string;
  bio?: string;          // 1 phrase courte/punchline ajoutée dans Strapi
  avatarURL?: string;
  href?: string;
}

const {
  name,
  role = 'Rédacteur',
  bio,
  avatarURL,
  href,
} = Astro.props;

const visible = Boolean(name);

// Initiales pour le fallback si pas d'avatar
const initials = (name || '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((s) => s[0]?.toUpperCase() || '')
  .join('');
---

{visible && (
  <aside class="author-card" aria-label={`Rédacteur : ${name}`}>
    <div class="author-portrait">
      {avatarURL ? (
        <img class="author-avatar" src={avatarURL} alt={name} loading="lazy" />
      ) : (
        <div class="author-avatar author-avatar--placeholder" aria-hidden="true">
          {initials}
        </div>
      )}
    </div>

    <div class="author-divider" aria-hidden="true">
      <span class="author-divider-line"></span>
      <span class="author-divider-mark">✦</span>
      <span class="author-divider-line"></span>
    </div>

    <div class="author-eyebrow">{role}</div>

    {href ? (
      <a class="author-name" href={href}>{name}</a>
    ) : (
      <span class="author-name">{name}</span>
    )}

    {bio && <p class="author-bio" set:html={bio}></p>}

    <div class="author-tail" aria-hidden="true"></div>
  </aside>
)}

<style>
  /* === Frontispice rédacteur ===
     Pas de box / pas de fond / pas de bordure. La carte est une composition
     typographique centrée, ancrée par un portrait carré encadré façon
     "tirage matté" (cohérent avec les images d'article). Le bloc texte
     descend en cascade : ornement gold → eyebrow → nom italique → bio.
     Un petit ornement de pied (✦) referme la composition. */
  .author-card {
    margin-top: 40px;
    text-align: center;
    padding: 0;
  }

  /* === Portrait carré façon tirage matté ===
     140×140 — taille calibrée pour laisser respirer la composition sans
     étouffer la colonne 220px. Bord blanc 8px + ring or 1px + ombre stratifiée.
     Coins légèrement arrondis (4px) pour adoucir sans virer au médaillon. */
  .author-portrait {
    margin: 0 auto 22px;
    width: 140px;
    height: 140px;
    padding: 7px;
    background: #FFFFFF;
    border-radius: 4px;
    box-shadow:
      0 0 0 1px rgba(191, 155, 102, 0.5),
      0 4px 12px -4px rgba(16, 20, 47, 0.18),
      0 18px 36px -14px rgba(16, 20, 47, 0.32);
  }

  .author-avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
    background: var(--ivory-warm);
    filter: saturate(0.9) sepia(0.06) contrast(1.03);
  }
  .author-avatar--placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 56px;
    color: var(--gold-deep);
    border: 1px solid var(--gold-soft);
    filter: none;
    background: var(--paper);
  }

  /* === Filet or + ✦ central, comme une signature ouverte sous le portrait === */
  .author-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 auto 14px;
    width: 72%;
  }
  .author-divider-line {
    flex: 1;
    height: 1px;
    background: var(--gold);
    opacity: 0.55;
  }
  .author-divider-mark {
    color: var(--gold);
    font-size: 11px;
    line-height: 1;
  }

  /* === Eyebrow gold uppercase ===
     Tracking serré, taille minimale (9px) : ça donne la respiration éditoriale
     "petit cartouche de chapitre". */
  .author-eyebrow {
    font-family: var(--font-sans);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 8px;
  }

  /* === Nom italique Cormorant, gros, navy === */
  .author-name {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    line-height: 1.18;
    color: var(--navy);
    text-decoration: none;
    border: none;
    letter-spacing: -0.005em;
    margin-bottom: 14px;
  }
  a.author-name { transition: color 0.2s; }
  a.author-name:hover { color: var(--gold-deep); }

  /* === Bio = phrase courte / punchline ===
     Italique, guillemets gold en pseudo-éléments. Couleur plus contrastée
     (navy à 78%) et taille bumpée à 15px pour rester lisible dans la colonne 220px. */
  .author-bio {
    margin: 0 auto;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(16, 20, 47, 0.78);
    letter-spacing: 0.005em;
    max-width: 96%;
  }
  .author-bio::before {
    content: '« ';
    color: var(--gold);
    font-style: normal;
    font-weight: 500;
  }
  .author-bio::after {
    content: ' »';
    color: var(--gold);
    font-style: normal;
    font-weight: 500;
  }
  .author-bio :global(em) { font-style: normal; }

  /* === Pied : petite étoile or pour fermer la composition ===
     Affichée comme un ::before parce qu'on veut juste un caractère décoratif. */
  .author-tail {
    margin: 18px auto 0;
    height: 8px;
    color: var(--gold);
    font-size: 10px;
    line-height: 1;
    opacity: 0.7;
  }
  .author-tail::before {
    content: '✦';
  }

  /* === Mobile : on passe la carte en flow centré, max 320px === */
  @media (max-width: 1100px) {
    .author-card {
      margin: 0 auto;
      max-width: 320px;
    }
  }
</style>
