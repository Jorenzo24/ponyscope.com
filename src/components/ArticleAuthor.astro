---
// ArticleAuthor.astro
// Boîte rédacteur en sidebar gauche, design "frontispice vertical" :
//   - Avatar circulaire 112px avec liseré blanc + ombre stratifiée (cohérence
//     avec le traitement des images d'article).
//   - Filet or + petite étoile (✦) en séparateur décoratif.
//   - Eyebrow gold uppercase "RÉDACTEUR" (ou rôle passé en prop).
//   - Nom italique Cormorant en gros, centré.
//
// Contenu volontairement minimal (pas de bio) — la richesse est dans la
// composition visuelle. Position sticky pour suivre la lecture.
//
// L'avatarURL doit être déjà absolu (résolu par le parent via mediaURL).

export interface Props {
  name?: string;
  role?: string;
  bio?: string;          // ignoré (compat backwards) — le design est volontairement sans bio
  avatarURL?: string;
  href?: string;
}

const {
  name,
  role = 'Rédacteur',
  avatarURL,
  href,
} = Astro.props;

const visible = Boolean(name);

// Initiales pour le fallback si pas d'avatar
const initials = (name || '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((s) => s[0]?.toUpperCase() || '')
  .join('');
---

{visible && (
  <aside class="author-card" aria-label={`Rédacteur : ${name}`}>
    <div class="author-portrait">
      {avatarURL ? (
        <img class="author-avatar" src={avatarURL} alt={name} loading="lazy" />
      ) : (
        <div class="author-avatar author-avatar--placeholder" aria-hidden="true">
          {initials}
        </div>
      )}
    </div>

    <div class="author-divider" aria-hidden="true">
      <span class="author-divider-line"></span>
      <span class="author-divider-mark">✦</span>
      <span class="author-divider-line"></span>
    </div>

    <div class="author-eyebrow">{role}</div>

    {href ? (
      <a class="author-name" href={href}>{name}</a>
    ) : (
      <span class="author-name">{name}</span>
    )}
  </aside>
)}

<style>
  .author-card {
    position: sticky;
    top: 100px;
    text-align: center;
    padding: 24px 8px 24px;
  }

  /* === Portrait : avatar circulaire dans un cadre blanc, ombre stratifiée ===
     Cohérence avec le traitement "tirage matté" appliqué aux images d'article. */
  .author-portrait {
    margin: 0 auto 22px;
    width: 112px;
    height: 112px;
    padding: 6px;
    background: #FFFFFF;
    border-radius: 50%;
    box-shadow:
      0 4px 12px -4px rgba(16, 20, 47, 0.18),
      0 16px 36px -12px rgba(16, 20, 47, 0.35);
  }

  .author-avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    background: var(--ivory-warm);
    filter: saturate(0.9) sepia(0.06) contrast(1.03);
  }
  .author-avatar--placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 38px;
    color: var(--gold-deep);
    border: 1px solid var(--gold-soft);
    filter: none;
    background: var(--paper);
  }

  /* === Filet or avec étoile centrale === */
  .author-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 0 auto 16px;
    width: 78%;
  }
  .author-divider-line {
    flex: 1;
    height: 1px;
    background: var(--gold);
    opacity: 0.55;
  }
  .author-divider-mark {
    color: var(--gold);
    font-size: 11px;
    line-height: 1;
  }

  /* === Eyebrow gold uppercase === */
  .author-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 14px;
  }

  /* === Nom italique Cormorant === */
  .author-name {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    line-height: 1.2;
    color: var(--navy);
    text-decoration: none;
    border: none;
    letter-spacing: -0.005em;
  }
  a.author-name { transition: color 0.2s; }
  a.author-name:hover { color: var(--gold-deep); }

  /* En dessous de 1100px, la sidebar disparaît dans le flow mobile → on
     enlève le sticky et on réduit le padding. */
  @media (max-width: 1100px) {
    .author-card {
      position: static;
      top: auto;
      padding: 0;
    }
    .author-portrait {
      width: 96px;
      height: 96px;
    }
  }
</style>
