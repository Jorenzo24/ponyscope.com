---
// ArticleTOC.astro
// Sommaire latéral gauche en box paper + sticky-deferred :
//   - Démarre en flux normal en haut de sa colonne
//   - Quand son bas atteint le bas du viewport → s'épingle (position: fixed)
//   - Quand on arrive au bas du parent (grid) → s'arrête (position: absolute)
//
// + scroll spy : highlight le lien correspondant au heading visible.
// + click smooth scroll (smooth-scroll est déjà global via BaseLayout).
//
// Caché sous 1100px (mobile/tablet).

export interface Props {
  headings: Array<{ level: number; text: string; id: string }>;
  label?: string;
}

const { headings = [], label = 'Sommaire' } = Astro.props;
const visible = headings.length >= 2;
---

{visible && (
  <aside class="toc-wrap">
    <div class="toc" id="article-toc">
      <div class="toc-title">{label}</div>
      <ul>
        {headings.map((h) => (
          <li class={`toc-level-${h.level}`}>
            <a href={`#${h.id}`} data-target={h.id}>{h.text}</a>
          </li>
        ))}
      </ul>
    </div>
  </aside>
)}

<style>
  /* === Wrap + box ===
     On vire la dureté du précédent (border 1px et barres verticales sur chaque
     item) pour un look "petit feuillet posé" : paper bg + ombre douce, pas de
     bordure visible. */
  .toc-wrap {
    position: relative;
    align-self: start;
  }
  .toc {
    background: var(--paper);
    padding: 32px 26px 30px;
    box-shadow:
      0 1px 0 rgba(16, 20, 47, 0.04),
      0 20px 40px -30px rgba(16, 20, 47, 0.18);
    transition: none;
  }
  .toc.is-pinned {
    position: fixed;
    width: var(--toc-width, 220px);
  }
  .toc.is-bottom {
    position: absolute;
    bottom: 0;
    width: 100%;
  }

  /* === Titre "Sommaire" === italique serif + filet or */
  .toc-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    font-weight: 400;
    color: var(--navy);
    letter-spacing: -0.005em;
    margin-bottom: 18px;
    padding-bottom: 14px;
    position: relative;
  }
  .toc-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 1px;
    background: var(--gold);
  }

  /* === Liste === */
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .toc li { margin: 0; }
  .toc a {
    position: relative;
    display: block;
    padding: 7px 0 7px 16px;
    color: var(--ink-mid);
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.35;
    text-decoration: none;
    border: none;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }
  /* Petit tiret or en marqueur, à la fois discret et identifiable */
  .toc a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 14px;
    width: 8px;
    height: 1px;
    background: var(--gold-soft);
    opacity: 0.55;
    transition: width 0.25s ease, background 0.25s ease, opacity 0.25s ease;
  }
  .toc a:hover {
    color: var(--navy);
  }
  .toc a:hover::before {
    width: 12px;
    opacity: 1;
    background: var(--gold);
  }
  .toc a.is-active {
    color: var(--navy);
    font-weight: 500;
    padding-left: 22px;
  }
  /* Marqueur "actif" : losange or */
  .toc a.is-active::before {
    content: '✦';
    background: none;
    color: var(--gold);
    width: auto;
    height: auto;
    top: 6px;
    font-size: 10px;
    opacity: 1;
  }

  /* === h3 = sous-rubriques (italique, indenté, plus petit) === */
  .toc-level-3 a {
    padding-left: 28px;
    font-size: 12.5px;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.3;
  }
  .toc-level-3 a::before {
    left: 14px;
    width: 6px;
    opacity: 0.4;
  }
  .toc-level-3 a:hover::before { width: 8px; }
  .toc-level-3 a.is-active {
    padding-left: 32px;
  }
  .toc-level-3 a.is-active::before {
    left: 14px;
    font-size: 9px;
    top: 5px;
  }

  @media (max-width: 1100px) {
    .toc-wrap { display: none; }
  }
</style>

<script>
  // === STICKY-DEFERRED + SCROLL SPY ===
  // Pattern : la TOC scrolle normalement avec la page jusqu'à ce que SON BAS
  // atteigne le bas du viewport, puis elle s'ancre. Quand on remonte au-dessus
  // de sa position initiale, elle revient en flux normal. Quand le bas du
  // conteneur parent est atteint, elle se pose en `position: absolute`.
  (function () {
    const tocWrap = document.querySelector<HTMLElement>('.toc-wrap');
    const toc = document.getElementById('article-toc');
    if (!tocWrap || !toc) return;

    const MARGIN_BOTTOM = 30; // marge entre le bas TOC et le bas viewport quand épinglée

    let wrapTop = 0;
    let wrapWidth = 0;
    let tocHeight = 0;

    function measure() {
      // Reset pour mesurer en flux normal
      toc!.classList.remove('is-pinned', 'is-bottom');
      toc!.style.width = '';

      const wrapRect = tocWrap!.getBoundingClientRect();
      wrapTop = wrapRect.top + window.scrollY;
      wrapWidth = tocWrap!.offsetWidth;
      tocHeight = toc!.offsetHeight;

      // Réserve l'espace dans le flux quand la TOC est fixed/absolue
      tocWrap!.style.minHeight = tocHeight + 'px';
      toc!.style.setProperty('--toc-width', wrapWidth + 'px');
    }

    function updatePin() {
      const scrollY = window.scrollY;
      const vh = window.innerHeight;

      const pinThreshold = wrapTop + tocHeight - vh + MARGIN_BOTTOM;

      const parent = tocWrap!.parentElement;
      if (!parent) return;
      const parentRect = parent.getBoundingClientRect();
      const parentBottom = parentRect.bottom + scrollY;
      const stopThreshold = parentBottom - tocHeight;

      if (scrollY < pinThreshold) {
        // En flux normal (au-dessus du seuil d'ancrage)
        toc!.classList.remove('is-pinned', 'is-bottom');
        toc!.style.top = '';
      } else if (scrollY >= stopThreshold) {
        // On a atteint le bas du conteneur : la TOC se pose
        toc!.classList.remove('is-pinned');
        toc!.classList.add('is-bottom');
        toc!.style.top = '';
      } else {
        // Épinglée en bas du viewport
        toc!.classList.add('is-pinned');
        toc!.classList.remove('is-bottom');
        toc!.style.top = vh - tocHeight - MARGIN_BOTTOM + 'px';
      }
    }

    // === Scroll spy ===
    const links = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>('a[data-target]')
    );
    const targets = links
      .map((link) => {
        const id = link.dataset.target || '';
        const el = document.getElementById(id);
        return el ? { id, link, el } : null;
      })
      .filter(
        (x): x is { id: string; link: HTMLAnchorElement; el: HTMLElement } =>
          x !== null
      );

    let currentActiveId: string | null = null;
    function updateSpy() {
      const offset = window.innerHeight * 0.3;
      let activeId: string | null = null;
      for (const t of targets) {
        const rect = t.el.getBoundingClientRect();
        if (rect.top - offset <= 0) activeId = t.id;
        else break;
      }
      if (activeId !== currentActiveId) {
        currentActiveId = activeId;
        for (const t of targets) {
          t.link.classList.toggle('is-active', t.id === activeId);
        }
      }
    }

    // rAF throttle pour scroll & resize
    let rafScheduled = false;
    function onTick() {
      if (rafScheduled) return;
      rafScheduled = true;
      requestAnimationFrame(() => {
        rafScheduled = false;
        updatePin();
        updateSpy();
      });
    }

    measure();
    updatePin();
    updateSpy();

    window.addEventListener('scroll', onTick, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        measure();
        updatePin();
        updateSpy();
      },
      { passive: true }
    );
  })();
</script>
