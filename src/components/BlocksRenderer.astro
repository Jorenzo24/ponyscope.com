---
import { mediaURL, slugifyHeading, nodeText } from '../lib/strapi.js';

interface Props {
  blocks: any[];
  // Index de bloc APRÈS lequel on insère le contenu du slot "midroll".
  // null/hors-bornes → pas d'injection (rendu normal d'un seul tenant).
  injectAfterIndex?: number | null;
}

const { blocks = [], injectAfterIndex = null } = Astro.props;

// Compteur de slugs pour gérer les headings qui auraient le même texte.
// Doit produire EXACTEMENT les mêmes ids qu'extractHeadings (cf. strapi.js).
const usedSlugs = new Map<string, number>();

function escapeHtml(text: string): string {
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function youtubeId(url: string): string | null {
  if (!url) return null;
  const patterns = [
    /youtube\.com\/embed\/([a-zA-Z0-9_-]{11})/,
    /youtube\.com\/watch\?v=([a-zA-Z0-9_-]{11})/,
    /youtu\.be\/([a-zA-Z0-9_-]{11})/,
  ];
  for (const re of patterns) {
    const m = url.match(re);
    if (m) return m[1];
  }
  return null;
}

// Une URL n'est promue en VRAI embed que si elle pointe sur /embed/.
// Les URLs /watch?v= et youtu.be restent des liens texte (souvent des
// crédits ou des "voir la vidéo originale" dans les articles migrés du WP).
function isYoutubeEmbedURL(url: string): boolean {
  return Boolean(url && /youtube\.com\/embed\//.test(url));
}

function giphyId(url: string): string | null {
  if (!url) return null;
  const m = url.match(/giphy\.com\/embed\/([a-zA-Z0-9]+)/);
  return m ? m[1] : null;
}

// Les vieux articles WP migrés contiennent souvent des liens
// "//giphy.com/embed/XXX" (protocol-relative) qu'on rendait jusqu'ici
// comme du texte. Idem que YouTube : on les promeut en iframe.
function isGiphyEmbedURL(url: string): boolean {
  return Boolean(url && /giphy\.com\/embed\//.test(url));
}

function renderText(node: any): string {
  let html = escapeHtml(node.text || '');
  if (node.code) html = '<code>' + html + '</code>';
  if (node.bold) html = '<strong>' + html + '</strong>';
  if (node.italic) html = '<em>' + html + '</em>';
  if (node.underline) html = '<u>' + html + '</u>';
  if (node.strikethrough) html = '<s>' + html + '</s>';
  return html;
}

function renderInline(children: any[]): string {
  if (!Array.isArray(children)) return '';
  return children.map((child) => {
    if (child.type === 'text') return renderText(child);
    if (child.type === 'link') {
      const inner = renderInline(child.children || []);
      const isExternal = child.url && child.url.startsWith('http');
      const target = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
      return '<a href="' + escapeHtml(child.url || '#') + '"' + target + '>' + inner + '</a>';
    }
    return '';
  }).join('');
}

// Heuristique "ligne de crédit image" : on capture les paragraphes courts
// qui démarrent par Source/Crédit/Photo/Photos/Illustration/via/©/Image suivi
// d'un séparateur (:, ·, -, —). Ces lignes sont stylées beaucoup plus petites
// (cf. .article-credit dans le style ci-dessous).
function isCreditLine(text: string): boolean {
  const t = (text || '').trim();
  if (!t || t.length > 140) return false;
  return /^(source|cr[ée]dit|cr[ée]dits|credits|photo|photos|illustration|via|©|image)s?\s*[:·\-—]/i.test(t);
}

function renderBlock(block: any): string {
  if (block.type === 'paragraph') {
    // On ne promeut le paragraphe en embed que si on trouve une URL /embed/.
    // Tout le reste (liens /watch?v=, youtu.be) est rendu comme un paragraphe
    // normal avec un lien cliquable, pour éviter de doubler les vidéos quand
    // l'article a un embed suivi d'un lien de crédit.
    const ytEmbedLink = (block.children || []).find(
      (c: any) => c.type === 'link' && isYoutubeEmbedURL(c.url || '')
    );
    if (ytEmbedLink) {
      const ytId = youtubeId(ytEmbedLink.url);
      return '<div class="video-embed"><iframe src="https://www.youtube.com/embed/' + ytId + '" title="YouTube video" frameborder="0" allowfullscreen></iframe></div>';
    }
    const giphyEmbedLink = (block.children || []).find(
      (c: any) => c.type === 'link' && isGiphyEmbedURL(c.url || '')
    );
    if (giphyEmbedLink) {
      const gifId = giphyId(giphyEmbedLink.url);
      return '<div class="gif-embed"><iframe src="https://giphy.com/embed/' + gifId + '" title="GIF Giphy" frameborder="0" allowfullscreen></iframe></div>';
    }
    const plain = nodeText(block).trim();
    if (isCreditLine(plain)) {
      return '<p class="article-credit">' + renderInline(block.children || []) + '</p>';
    }
    return '<p>' + renderInline(block.children || []) + '</p>';
  }

  if (block.type === 'heading') {
    const level = Math.min(Math.max(block.level || 2, 1), 6);
    // On émet un id stable sur h2/h3 pour permettre l'ancrage du TOC.
    let idAttr = '';
    if (level === 2 || level === 3) {
      const plain = nodeText(block).trim();
      if (plain) {
        let id = slugifyHeading(plain);
        if (usedSlugs.has(id)) {
          const n = (usedSlugs.get(id) || 1) + 1;
          usedSlugs.set(id, n);
          id = id + '-' + n;
        } else {
          usedSlugs.set(id, 1);
        }
        idAttr = ' id="' + id + '"';
      }
    }
    // Avant chaque h2 : un séparateur orné (deux filets or + fer à cheval)
    const divider = level === 2
      ? '<div class="h2-divider" aria-hidden="true"><span class="h2-divider-mark"></span></div>'
      : '';
    return divider + '<h' + level + idAttr + '>' + renderInline(block.children || []) + '</h' + level + '>';
  }

  if (block.type === 'image' && block.image) {
    const img = block.image;
    const src = mediaURL(img.url);
    const alt = escapeHtml(img.alternativeText || '');
    const w = img.width ? ' width="' + img.width + '"' : '';
    const h = img.height ? ' height="' + img.height + '"' : '';
    const caption = img.caption ? '<figcaption>' + escapeHtml(img.caption) + '</figcaption>' : '';
    return '<figure><img src="' + src + '" alt="' + alt + '"' + w + h + ' loading="lazy" />' + caption + '</figure>';
  }

  if (block.type === 'list') {
    const tag = block.format === 'ordered' ? 'ol' : 'ul';
    const items = (block.children || []).map((item: any) => {
      if (item.type === 'list-item') {
        return '<li>' + renderInline(item.children || []) + '</li>';
      }
      return '';
    }).join('');
    return '<' + tag + '>' + items + '</' + tag + '>';
  }

  if (block.type === 'quote') {
    return '<blockquote>' + renderInline(block.children || []) + '</blockquote>';
  }

  if (block.type === 'code') {
    const codeText = (block.children || []).map((c: any) => c.text || '').join('');
    return '<pre><code>' + escapeHtml(codeText) + '</code></pre>';
  }

  return '';
}

// Point de coupe : on rend AVANT et APRÈS en un seul passage séquentiel pour
// que la déduplication des ancres (usedSlugs) reste continue d'un bout à l'autre.
const doSplit =
  typeof injectAfterIndex === 'number' &&
  injectAfterIndex >= 0 &&
  injectAfterIndex < blocks.length - 1;

const htmlBefore = doSplit
  ? blocks.slice(0, injectAfterIndex + 1).map(renderBlock).join('')
  : blocks.map(renderBlock).join('');
const htmlAfter = doSplit
  ? blocks.slice(injectAfterIndex + 1).map(renderBlock).join('')
  : '';
---

<div class="article-body" set:html={htmlBefore} />
{doSplit && (
  <Fragment>
    <slot name="midroll" />
    <div class="article-body" set:html={htmlAfter} />
  </Fragment>
)}

<style>
  .article-body :global(p) {
    margin: 1rem 0;
    line-height: 1.7;
  }
  /* Ligne de crédit image ("Source : Pixabay", "Photo : …", "© …", etc.) :
     beaucoup plus petite et discrète. Marge-top négative pour la rapprocher
     de l'image au-dessus (qui a souvent sa propre marge généreuse). */
  .article-body :global(.article-credit) {
    margin: -28px 0 32px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-soft);
    text-align: center;
    letter-spacing: 0.04em;
  }
  .article-body :global(.article-credit a) {
    color: var(--ink-soft);
    border-bottom: 1px solid rgba(191, 155, 102, 0.4);
  }
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    margin: 2rem 0 1rem;
    line-height: 1.3;
  }
  .article-body :global(figure) {
    margin: 2rem 0;
    text-align: center;
  }
  .article-body :global(figure img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .article-body :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: #666;
    font-style: italic;
  }
  .article-body :global(blockquote) {
    border-left: 3px solid #BF9B66;
    padding-left: 1.2rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #555;
  }
  .article-body :global(pre) {
    background: #f6f6f6;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  .article-body :global(a) {
    color: #10142F;
    text-decoration: underline;
    text-decoration-color: #BF9B66;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  .article-body :global(li) {
    margin: 0.3rem 0;
  }
  .article-body :global(.video-embed) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 2rem 0;
  }
  .article-body :global(.video-embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 4px;
  }
  /* GIFs Giphy : carré par défaut (la majorité des Giphy le sont) et
     largeur contenue pour rester dans une lecture confortable.
     Même traitement que les images : liseré blanc + ombre stratifiée. */
  .article-body :global(.gif-embed) {
    position: relative;
    width: 100%;
    max-width: 480px;
    aspect-ratio: 1 / 1;
    margin: 2rem auto;
    border: 8px solid #FFFFFF;
    border-radius: 4px;
    background: #FFFFFF;
    box-shadow:
      0 4px 12px -4px rgba(16, 20, 47, 0.18),
      0 24px 56px -18px rgba(16, 20, 47, 0.42);
  }
  .article-body :global(.gif-embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>