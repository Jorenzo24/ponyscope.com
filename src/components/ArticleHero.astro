---
// ArticleHero.astro
// Hero 100vh d'un article : image Strapi en background + overlay gradient
// + eyebrow (catégorie · date) + h1 + byline auteur

export interface Props {
  title: string;
  cover?: string;          // URL de l'image Strapi
  category?: string;       // Ex: "Blog", "Tops"
  date?: string;           // Ex: "21 novembre 2010"
  author?: string;         // Ex: "Joseph Lambert"
  authorRole?: string;     // Ex: "Rédacteur"
}

const {
  title,
  cover,
  category,
  date,
  author,
  authorRole = "Rédacteur",
} = Astro.props;
---

<header class="hero">
  {cover && (
    <div
      class="hero-image"
      style={`background-image: url('${cover}')`}
    ></div>
  )}
  <div class="hero-overlay"></div>
  <div class="hero-content">
    {(category || date) && (
      <div class="hero-eyebrow">
        {category && <span class="category">{category}</span>}
        {category && date && <span class="sep"></span>}
        {date && <span class="meta">{date}</span>}
      </div>
    )}
    <h1 class="hero-title" set:html={title}></h1>
    {author && (
      <div class="hero-byline">
        <span class="name">{author}</span>
        <span class="divider"></span>
        <span class="role">{authorRole}</span>
      </div>
    )}
  </div>
  <div class="hero-scroll">
    <span>Lire l'article</span>
    <span class="hero-scroll-line"></span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 720px;
    max-height: 900px;
    overflow: hidden;
    color: var(--paper);
  }
  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(8, 10, 31, 0.3) 0%,
      rgba(8, 10, 31, 0.2) 30%,
      rgba(8, 10, 31, 0.85) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 3;
    height: 100%;
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 48px 80px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-weight: 500;
  }
  .hero-eyebrow .category {
    color: var(--gold-soft);
    border: 1px solid var(--gold);
    padding: 8px 16px;
    background: transparent;
  }
  .hero-eyebrow .meta {
    color: rgba(250, 246, 238, 0.7);
  }
  .hero-eyebrow .sep {
    width: 30px;
    height: 1px;
    background: var(--gold);
  }

  h1.hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(48px, 7vw, 104px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin-bottom: 36px;
    max-width: 1200px;
    color: var(--paper);
  }
  h1.hero-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--gold-soft);
  }

  .hero-byline {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    color: rgba(250, 246, 238, 0.75);
  }
  .hero-byline .name {
    color: var(--paper);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .hero-byline .name::before {
    content: 'Par ';
    color: rgba(250, 246, 238, 0.5);
    font-weight: 400;
  }
  .hero-byline .divider {
    width: 1px;
    height: 14px;
    background: rgba(250, 246, 238, 0.3);
  }
  .hero-byline .role {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 11px;
  }

  .hero-scroll {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    color: rgba(250, 246, 238, 0.6);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    animation: floaty 2.5s ease-in-out infinite;
  }
  .hero-scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(180deg, transparent, var(--gold));
  }
  @keyframes floaty {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  @media (max-width: 768px) {
    .hero { min-height: 580px; }
    .hero-content { padding: 0 24px 60px; }
    h1.hero-title { font-size: 44px; margin-bottom: 24px; }
    .hero-eyebrow {
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 28px;
    }
    .hero-eyebrow .sep { display: none; }
    .hero-byline { flex-wrap: wrap; gap: 10px; }
  }
</style>
