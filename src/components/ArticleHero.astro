---
// ArticleHero.astro
// Hero typographique pur : pas d'image, juste la composition typo qui pose
// le ton du magazine. L'image de couverture descend dans le flow de lecture
// (cf. ArticleBody.astro) — ça résout aussi le problème de résolution sur les
// images héritées de la migration WordPress.
//
// Philosophie : un frontispice de magazine premium. Navy, or, Cormorant.
// Aucun effet gratuit, juste de la typographie tenue.

import OrnamentDivider from './OrnamentDivider.astro';

export interface Props {
  title: string;
  category?: string;       // Ex: "Blog", "Tops", "Tutos"
  date?: string;           // Ex: "21 novembre 2010"
  author?: string;         // Ex: "Pauline Bach"
  authorRole?: string;     // Ex: "Rédactrice"
  readingTime?: number;    // optionnel : minutes (ex: 7)
}

const {
  title,
  category,
  date,
  author,
  authorRole = 'Rédacteur',
  readingTime,
} = Astro.props;
---

<header class="hero">
  <div class="hero-veil"></div>

  <div class="hero-content">
    {(category || date || readingTime) && (
      <div class="hero-eyebrow">
        {category && <span class="eyebrow-item category">{category}</span>}
        {category && (date || readingTime) && <span class="eyebrow-dot">·</span>}
        {date && <time class="eyebrow-item date">{date}</time>}
        {date && readingTime && <span class="eyebrow-dot">·</span>}
        {readingTime && (
          <span class="eyebrow-item reading">
            Lecture · {readingTime} min
          </span>
        )}
      </div>
    )}

    <h1 class="hero-title" set:html={title}></h1>

    <OrnamentDivider symbol="✦" width="56px" variant="gold-soft" marginY="0" />

    {author && (
      <div class="hero-byline">
        <span class="prefix">Par</span>
        <span class="name">{author}</span>
        {authorRole && (
          <>
            <span class="dot">·</span>
            <span class="role">{authorRole}</span>
          </>
        )}
      </div>
    )}
  </div>

  <div class="hero-scroll">
    <span class="hero-scroll-line"></span>
    <span class="hero-scroll-text">Lire</span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    height: 100vh;
    max-height: 940px;
    background:
      radial-gradient(
        ellipse 120% 80% at center,
        transparent 0%,
        rgba(8, 10, 31, 0.55) 100%
      ),
      var(--navy);
    color: var(--paper);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Voile texturé très subtil pour casser le navy "plat" */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      repeating-linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.012) 0 1px,
        transparent 1px 3px
      );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    padding: 0 48px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* === Eyebrow : catégorie · date · lecture === */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 56px;
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: rgba(250, 246, 238, 0.7);
  }
  .eyebrow-item.category {
    color: var(--gold-soft);
    border: 1px solid rgba(191, 155, 102, 0.6);
    padding: 9px 18px 7px;
    letter-spacing: 0.34em;
    font-weight: 500;
  }
  .eyebrow-item.date,
  .eyebrow-item.reading {
    font-weight: 400;
  }
  .eyebrow-dot {
    color: var(--gold);
    opacity: 0.7;
    font-size: 14px;
    line-height: 1;
  }

  /* === Titre — la pièce centrale === */
  h1.hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(52px, 7.2vw, 118px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 44px;
    color: var(--paper);
    max-width: 1100px;
  }
  h1.hero-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--gold-soft);
  }

  /* === Byline auteur === */
  .hero-byline {
    margin-top: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(250, 246, 238, 0.8);
  }
  .hero-byline .prefix {
    color: rgba(250, 246, 238, 0.5);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    letter-spacing: 0.01em;
  }
  .hero-byline .name {
    color: var(--paper);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .hero-byline .dot {
    color: var(--gold);
    opacity: 0.7;
  }
  .hero-byline .role {
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 10px;
    color: rgba(250, 246, 238, 0.55);
    font-weight: 500;
  }

  /* === Indicateur "Lire" en bas du hero === */
  .hero-scroll {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    color: rgba(250, 246, 238, 0.45);
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    animation: heroFloat 3s ease-in-out infinite;
  }
  .hero-scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(180deg, transparent, var(--gold));
  }
  @keyframes heroFloat {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, 7px); }
  }

  @media (max-width: 768px) {
    .hero { height: auto; min-height: 88vh; padding: 120px 0 100px; }
    .hero-content { padding: 0 24px; }
    .hero-eyebrow {
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 36px;
      letter-spacing: 0.22em;
      font-size: 10px;
    }
    .eyebrow-item.category { padding: 7px 14px 5px; }
    h1.hero-title {
      font-size: clamp(40px, 9vw, 64px);
      margin-bottom: 32px;
    }
    .hero-byline { margin-top: 32px; gap: 10px; }
    .hero-byline .name,
    .hero-byline .prefix { font-size: 15px; }
    .hero-scroll { bottom: 24px; }
  }
</style>
