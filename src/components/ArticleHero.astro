---
// ArticleHero.astro
// Hero typographique pur : pas d'image, juste la composition typo qui pose
// le ton du magazine. L'image de couverture descend dans le flow de lecture
// (cf. ArticleBody.astro) — ça résout aussi le problème de résolution sur les
// images héritées de la migration WordPress.
//
// Philosophie : un frontispice de magazine premium. Navy, or, Cormorant.
// Aucun effet gratuit, juste de la typographie tenue.

import OrnamentDivider from './OrnamentDivider.astro';

export interface Props {
  title: string;
  category?: string;       // Ex: "Blog", "Tops", "Tutos"
  date?: string;           // Ex: "21 novembre 2010"
  readingTime?: number;    // optionnel : minutes (ex: 7)
  breadcrumb?: Array<{ label: string; path: string }>;
}

const {
  title,
  category,
  date,
  readingTime,
  breadcrumb = [],
} = Astro.props;
---

<header class="hero">
  <div class="hero-veil"></div>

  <div class="hero-content">
    {breadcrumb.length > 0 && (
      <nav class="hero-crumbs" aria-label="Fil d'ariane">
        <a href="/">Accueil</a>
        {breadcrumb.map((c) => (
          <>
            <span class="crumb-sep">·</span>
            <a href={c.path}>{c.label}</a>
          </>
        ))}
      </nav>
    )}

    <h1 class="hero-title" set:html={title}></h1>

    {(category || date || readingTime) && (
      <div class="hero-eyebrow">
        {category && <span class="eyebrow-item category">{category}</span>}
        {category && (date || readingTime) && <span class="eyebrow-dot">·</span>}
        {date && <time class="eyebrow-item date">{date}</time>}
        {date && readingTime && <span class="eyebrow-dot">·</span>}
        {readingTime && (
          <span class="eyebrow-item reading">
            Lecture · {readingTime} min
          </span>
        )}
      </div>
    )}

    <OrnamentDivider symbol="✦" width="56px" variant="gold-soft" marginY="0" />
  </div>

  <div class="hero-scroll">
    <span class="hero-scroll-line"></span>
    <span class="hero-scroll-text">Lire</span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 460px;
    height: 54vh;
    max-height: 560px;
    background:
      /* Halo doré subtil qui "monte" du bas — chaleur de bougie / lampe
         d'imprimerie, donne envie de descendre vers la page papier. */
      linear-gradient(
        to bottom,
        transparent 60%,
        rgba(191, 155, 102, 0.08) 85%,
        rgba(191, 155, 102, 0.18) 100%
      ),
      /* Vignette principale, un poil plus tiède au centre. */
      radial-gradient(
        ellipse 130% 90% at center,
        rgba(28, 22, 36, 0.42) 0%,
        rgba(8, 10, 31, 0.84) 100%
      ),
      url('/hero-background.png') center / cover no-repeat,
      var(--navy);
    color: var(--paper);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Filet or fin sur le bord bas : transition entre navy et paper, façon
     "trait sous le titre du chapitre" d'un livre relié. Dégradé pour qu'il
     fonde sur les bords plutôt que de couper net. */
  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 5%,
      rgba(191, 155, 102, 0.55) 32%,
      rgba(191, 155, 102, 0.78) 50%,
      rgba(191, 155, 102, 0.55) 68%,
      transparent 95%
    );
    z-index: 3;
    pointer-events: none;
  }

  /* Voile texturé très subtil pour casser le navy "plat" */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      repeating-linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.012) 0 1px,
        transparent 1px 3px
      );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    padding: 0 48px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* === Fil d'ariane au top du hero === */
  .hero-crumbs {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: rgba(250, 246, 238, 0.55);
  }
  .hero-crumbs a {
    color: rgba(250, 246, 238, 0.75);
    text-decoration: none;
    border-bottom: none;
    transition: color 0.2s;
  }
  .hero-crumbs a:hover { color: var(--gold-soft); }
  .hero-crumbs .crumb-sep { color: var(--gold); opacity: 0.6; }

  /* === Eyebrow : catégorie · date · lecture ===
     Maintenant SOUS le titre — moins de margin-bottom (juste avant l'ornement) */
  .hero-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 26px;
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: rgba(250, 246, 238, 0.7);
  }
  .eyebrow-item.category {
    color: var(--gold-soft);
    border: 1px solid rgba(191, 155, 102, 0.6);
    padding: 9px 18px 7px;
    letter-spacing: 0.34em;
    font-weight: 500;
  }
  .eyebrow-item.date,
  .eyebrow-item.reading {
    font-weight: 400;
  }
  .eyebrow-dot {
    color: var(--gold);
    opacity: 0.7;
    font-size: 14px;
    line-height: 1;
  }

  /* === Titre — la pièce centrale ===
     Max légèrement réduit (88→76px) suite au raccourcissement du hero,
     pour que le titre respire dans la nouvelle hauteur. */
  h1.hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 5vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.022em;
    margin-bottom: 32px;
    color: var(--paper);
    max-width: 920px;
    /* Équilibre les lignes (titres longs en 3 lignes plutôt qu'1 ligne très
       courte + 1 grosse). Pas de césure auto, le browser cassait moche au
       tiret naturel de mots comme "bien-être". */
    text-wrap: balance;
    hyphens: manual;
  }
  h1.hero-title em {
    font-style: italic;
    font-weight: 300;
    color: var(--gold-soft);
  }

  /* === Indicateur "Lire" en bas du hero === */
  .hero-scroll {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    color: rgba(250, 246, 238, 0.45);
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    animation: heroFloat 3s ease-in-out infinite;
  }
  .hero-scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(180deg, transparent, var(--gold));
  }
  @keyframes heroFloat {
    0%, 100% { transform: translate(-50%, 0); }
    50%      { transform: translate(-50%, 7px); }
  }

  @media (max-width: 768px) {
    .hero { height: auto; min-height: 64vh; padding: 100px 0 90px; max-height: none; }
    .hero-content { padding: 0 24px; }
    .hero-eyebrow {
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 36px;
      letter-spacing: 0.22em;
      font-size: 10px;
    }
    .eyebrow-item.category { padding: 7px 14px 5px; }
    h1.hero-title {
      font-size: clamp(40px, 9vw, 64px);
      margin-bottom: 32px;
    }
    .hero-scroll { bottom: 24px; }
  }
</style>
