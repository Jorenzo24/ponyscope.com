---
// ArticleTOCInline.astro
// TOC inline en haut d'article (entre cover et content), repliable.
// Remplace l'ancien TOC sidebar gauche : la grille 3 colonnes était fragile
// sur les articles longs (sticky-deferred JS + parent rect = bugs subtils),
// et chargeait visuellement l'espace de lecture.
//
// Design :
//   - Balise <details> native (zéro JS, accessible clavier, robuste).
//   - 2 filets or top/bottom comme une "table des chapitres" éditoriale.
//   - Numérotation italique des h2 (01, 02, 03...) façon livre.
//   - h3 indentés + italique + gris, sans numéro (clairement subordonnés).
//   - 2 colonnes sur desktop → la liste reste compacte même sur Top 10.
//
// Seuil d'affichage : au moins 3 chapitres h2 (sinon inutile).

export interface Props {
  headings: Array<{ level: number; text: string; id: string }>;
}

const { headings = [] } = Astro.props;

const h2Count = headings.filter((h) => h.level === 2).length;
const visible = h2Count >= 3;

// Pré-calcul des numéros de chapitre (uniquement sur les h2)
let chapterNum = 0;
const items = headings.map((h) => {
  if (h.level === 2) {
    chapterNum++;
    return { ...h, number: String(chapterNum).padStart(2, '0') };
  }
  return { ...h, number: null as string | null };
});
---

{visible && (
  <details class="toc-inline">
    <summary class="toc-summary">
      <span class="toc-summary-label">Sommaire</span>
      <span class="toc-summary-sep" aria-hidden="true">·</span>
      <span class="toc-summary-meta">{h2Count} chapitres</span>
      <span class="toc-summary-chevron" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
          <path d="M 3 6 L 8 11 L 13 6" />
        </svg>
      </span>
    </summary>

    <div class="toc-inline-divider" aria-hidden="true">
      <span></span>
      <span class="toc-inline-divider-mark">✦</span>
      <span></span>
    </div>

    <ol class="toc-inline-list">
      {items.map((h) => (
        <li class={`toc-inline-item toc-inline-item--h${h.level}`}>
          <a href={`#${h.id}`}>
            {h.number && <span class="toc-num">{h.number}</span>}
            <span class="toc-text">{h.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </details>
)}

<style>
  /* Conteneur : boîte ivory-warm pour se démarquer du paper du contenu.
     Ombre douce + border-radius pour un effet "carte posée". */
  .toc-inline {
    margin: 0 0 60px;
    background: var(--ivory-warm);
    border-radius: 4px;
    padding: 26px 36px;
    box-shadow:
      0 1px 0 rgba(16, 20, 47, 0.04),
      0 14px 30px -22px rgba(16, 20, 47, 0.20);
  }
  /* Cache la flèche native du <details> */
  .toc-inline summary::-webkit-details-marker { display: none; }
  .toc-inline summary::marker { content: ''; }

  /* === Header cliquable === */
  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    color: var(--navy);
    transition: color 0.2s;
  }
  .toc-summary:hover { color: var(--gold-deep); }

  .toc-summary-label {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--gold-deep);
    font-weight: 600;
  }
  .toc-summary-sep {
    color: var(--gold);
    opacity: 0.6;
    font-family: var(--font-sans);
    font-size: 11px;
  }
  .toc-summary-meta {
    color: var(--ink-mid);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0.005em;
  }
  .toc-summary-chevron {
    margin-left: 6px;
    color: var(--gold-deep);
    display: inline-flex;
    transition: transform 0.3s ease;
  }
  .toc-inline[open] .toc-summary-chevron {
    transform: rotate(180deg);
  }

  /* === Ornement décoratif sous le summary (visible quand ouvert) === */
  .toc-inline-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 22px auto 18px;
    width: 60%;
  }
  .toc-inline-divider > span:not(.toc-inline-divider-mark) {
    flex: 1;
    height: 1px;
    background: var(--gold);
    opacity: 0.55;
  }
  .toc-inline-divider-mark {
    color: var(--gold);
    font-size: 11px;
    line-height: 1;
  }

  /* === Liste dépliée — 1 SEULE colonne pour la clarté de lecture. */
  .toc-inline-list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }

  .toc-inline-item {
    margin: 0;
    padding: 0;
  }
  .toc-inline-item a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 11px 0;
    color: var(--navy);
    text-decoration: none;
    border: none;
    transition: color 0.2s;
  }
  .toc-inline-item a:hover { color: var(--gold-deep); }
  .toc-inline-item a:hover .toc-num { color: var(--gold); }

  .toc-num {
    flex: 0 0 auto;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--gold-deep);
    letter-spacing: 0;
    line-height: 1;
    min-width: 32px;
  }
  .toc-text {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.4;
    color: var(--navy);
  }
  .toc-text :global(em) { font-style: italic; }

  /* h3 : indenté, italique, gris, sans numéro */
  .toc-inline-item--h3 a {
    padding: 6px 0 6px 44px;
  }
  .toc-inline-item--h3 .toc-text {
    font-style: italic;
    font-size: 14px;
    color: var(--ink-mid);
  }

  /* === Animation très subtile au dépli === */
  .toc-inline[open] .toc-inline-list {
    animation: tocReveal 0.35s ease-out both;
  }
  @keyframes tocReveal {
    from { opacity: 0; transform: translateY(-4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .toc-inline { margin: 0 0 44px; padding: 20px 22px; }
    .toc-summary { flex-wrap: wrap; gap: 8px; }
    .toc-summary-meta { font-size: 14px; }
    .toc-inline-list { margin-top: 6px; }
    .toc-num { font-size: 18px; min-width: 28px; }
    .toc-text { font-size: 15px; }
  }
</style>
