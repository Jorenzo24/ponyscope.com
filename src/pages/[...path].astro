---
// src/pages/[...path].astro
// Catch-all qui sert SOIT une page article, SOIT une page catégorie selon le
// chemin demandé. Les deux types sont générés au build via getStaticPaths.

import {
  getAllArticles,
  getArticlePath,
  mediaURL,
  extractHeadings,
  getRelatedArticles,
  extractLedeFromBlocks,
  getCategoryTree,
  prettyCategoryName,
  getArticleBreadcrumb,
  isHiddenArticle,
} from '../lib/strapi.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleHero from '../components/ArticleHero.astro';
import ArticleBody from '../components/ArticleBody.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';
import CategoryView from '../components/CategoryView.astro';
import HoroscoponeyTeaser from '../components/HoroscoponeyTeaser.astro';

// ----- Génération des chemins statiques (SSG) -----
export async function getStaticPaths() {
  const articles = await getAllArticles();
  const categoryTree = getCategoryTree(articles);

  // 1) Pages d'article
  const articleEntries = articles
    .map((article) => {
      const fullPath = getArticlePath(article);
      const path = fullPath.replace(/^\/+/, '');
      const related = getRelatedArticles(article, articles, 3);
      return {
        params: { path },
        props: { kind: 'article', article, related },
      };
    })
    .filter((e) => e.params.path);

  // 2) Pages de catégorie (racines + sous-catégories)
  const categoryEntries = [...categoryTree.values()].map((cat) => {
    const path = cat.path.replace(/^\/+/, '');
    return {
      params: { path },
      props: { kind: 'category', category: cat },
    };
  }).filter((e) => e.params.path);

  // Si une catégorie partage exactement le même path qu'un article (cas
  // improbable mais à protéger), on garde la catégorie (la page article serait
  // un sous-segment de toute façon).
  const taken = new Set(categoryEntries.map((e) => e.params.path));
  const dedupedArticles = articleEntries.filter((e) => !taken.has(e.params.path));

  return [...categoryEntries, ...dedupedArticles];
}

// ----- Données de la page : on regarde le kind pour brancher l'affichage -----
const { kind } = Astro.props;
---

{kind === 'category' && (
  (() => {
    const { category } = Astro.props as { category: any };
    const catName = category.name || prettyCategoryName(category.slug);
    const metaTitle = `${catName} — Ponyscope`;
    const metaDescription = `Tous les articles Ponyscope dans la catégorie ${catName}.`;
    return (
      <BaseLayout
        title={metaTitle}
        description={metaDescription}
        noindex={false}
      >
        <Nav slot="nav" />
        <CategoryView category={category} />
        <Footer slot="footer" />
      </BaseLayout>
    );
  })()
)}

{kind === 'article' && (
  (() => {
    const { article, related } = Astro.props as { article: any; related: any[] };

    // SEO
    // Les titres migrés du WP (Yoast) traînent l'ancien nom de site en suffixe,
    // souvent tronqué à la migration ("… - Contre…", "… - Contre Galo…"). Certains
    // metaTitle ont déjà été rebrandés ("… - Ponyscope"), d'autres non, d'autres
    // sont vides. On normalise : on retire tout suffixe de marque (ancien OU
    // nouveau) en fin de titre, puis on ré-applique une marque unique et propre.
    // On part du VRAI titre (H1), propre et non tronqué, plutôt que du
    // seo.metaTitle Yoast (souvent tronqué "…" et suffixé de l'ancienne marque).
    const rawTitle = article.title || article.seo?.metaTitle || '';
    const baseTitle =
      String(rawTitle)
        .replace(/\s*[-–—|]\s*(?:contre\b[\s\S]*|ponyscope[\s\S]*)$/i, '')
        .trim() || String(article.title || '').trim();
    // Si le titre se termine déjà par le mot "Ponyscope" (présent dans le vrai
    // titre, ex. "…la team Ponyscope"), on n'ajoute pas la marque (évite le doublon).
    const metaTitle = /ponyscope\s*$/i.test(baseTitle)
      ? baseTitle
      : `${baseTitle} — Ponyscope`;
    const metaDescription = article.seo?.metaDescription || article.excerpt || '';
    const canonical = article.seo?.canonicalURL || '';
    const ogImage = article.seo?.metaImage?.url
      ? mediaURL(article.seo.metaImage.url)
      : article.cover?.url
        ? mediaURL(article.cover.url)
        : undefined;

    // Date affichée
    const publishedDate = article.originalPublishedAt
      ? new Date(article.originalPublishedAt).toLocaleDateString('fr-FR', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })
      : undefined;

    // Articles "cachés" (catégorie secret) : on n'expose ni la catégorie ni
    // le breadcrumb (qui pointerait vers une page catégorie qu'on ne génère
    // plus), et on force noindex même quand le noindex global sera levé.
    const isHidden = isHiddenArticle(article);
    const categoryName = isHidden ? undefined : article.primaryCategory?.name;
    const breadcrumb = isHidden ? [] : getArticleBreadcrumb(article);

    // Image de cover
    const coverURL = article.cover?.url ? mediaURL(article.cover.url) : undefined;
    const coverAlt = article.cover?.alternativeText || article.title || '';
    const coverCaption = article.cover?.caption || undefined;

    // Chapô (lede) : on prend le 1er paragraphe du contenu et on le retire
    // du flow pour qu'il ne soit pas affiché 2 fois. C'est plus propre que
    // l'excerpt Strapi (souvent tronqué avec un "[...]" disgracieux).
    // Si l'article ne démarre pas sur un paragraphe assez long, ledeHTML est
    // null et aucun chapô n'est affiché.
    const { ledeHTML, remainingBlocks } = extractLedeFromBlocks(article.content || []);
    const contentBlocks = remainingBlocks;

    // Headings (pour le TOC sidebar gauche)
    const headings = extractHeadings(contentBlocks);

    // Injection Horoscoponey au milieu : on l'insère dans un VRAI saut de ligne,
    // c.-à-d. entre deux paragraphes consécutifs les plus proches du centre
    // (et donc pas juste après une image ni en plein milieu d'une section).
    // Fallbacks dégressifs si l'article n'a pas de paire de paragraphes adjacents.
    const injectAfterIndex = (() => {
      const n = contentBlocks.length;
      if (n < 6) return null;
      const mid = Math.floor(n / 2);
      const isPara = (i: number) => (contentBlocks[i] as any)?.type === 'paragraph';

      // 1) Bord paragraphe → paragraphe le plus proche du milieu.
      let best = null;
      let bestDist = Infinity;
      for (let i = 1; i < n - 2; i++) {
        if (isPara(i) && isPara(i + 1)) {
          const dist = Math.abs(i - mid);
          if (dist < bestDist) { bestDist = dist; best = i; }
        }
      }
      if (best !== null) return best;

      // 2) À défaut : juste avant un paragraphe (jamais collé après une image).
      for (let d = 0; d < n; d++) {
        for (const i of [mid + d, mid - d]) {
          if (i >= 1 && i < n - 1 && isPara(i + 1)) return i;
        }
      }

      // 3) Dernier recours : milieu strict.
      return mid - 1;
    })();

    // Auteur
    const authorName = article.author?.name;
    const authorBio = article.author?.bio || undefined;
    const authorAvatarURL = article.author?.avatar?.url
      ? mediaURL(article.author.avatar.url)
      : undefined;
    const authorData = authorName
      ? {
          name: authorName,
          role: 'Rédacteur',
          bio: authorBio,
          avatarURL: authorAvatarURL,
        }
      : undefined;

    return (
      <BaseLayout
        title={metaTitle}
        description={metaDescription}
        canonicalURL={canonical || undefined}
        ogImage={ogImage}
        noindex={isHidden /* go-live : on indexe tous les articles réels ; seule la catégorie cachée reste noindex (données metaRobots migrées peu fiables) */}
      >
        <Nav slot="nav" />

        <ArticleHero
          title={article.title}
          category={categoryName}
          date={publishedDate}
          breadcrumb={breadcrumb}
        />

        <ArticleBody
          excerpt={ledeHTML || ''}
          cover={coverURL}
          coverAlt={coverAlt}
          coverCaption={coverCaption}
          headings={headings}
          author={authorData}
          related={related}
        >
          <BlocksRenderer blocks={contentBlocks} injectAfterIndex={injectAfterIndex}>
            <HoroscoponeyTeaser slot="midroll" seed={canonical || article.slug} />
          </BlocksRenderer>
        </ArticleBody>

        <Footer slot="footer" />
      </BaseLayout>
    );
  })()
)}
