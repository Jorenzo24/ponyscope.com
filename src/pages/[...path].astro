---
// src/pages/[...path].astro
// Template universel pour les articles Ponyscope.
// Au build, génère UNE page statique par article, à l'URL exacte du canonicalURL Strapi.

import {
  getAllArticles,
  getArticlePath,
  mediaURL,
  extractHeadings,
  getRelatedArticles,
} from '../lib/strapi.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleHero from '../components/ArticleHero.astro';
import ArticleBody from '../components/ArticleBody.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';

// ----- Génération des chemins statiques (SSG) -----
export async function getStaticPaths() {
  const articles = await getAllArticles();

  return articles
    .map((article) => {
      const fullPath = getArticlePath(article); // ex: "/blog/top-5-aquaponey"
      // Astro veut "path" sans le slash de tête pour [...path]
      const path = fullPath.replace(/^\/+/, '');

      // Articles liés calculés au build (même primaryCategory, exclu lui-même)
      const related = getRelatedArticles(article, articles, 3);

      return {
        params: { path },
        props: { article, related },
      };
    })
    .filter((entry) => entry.params.path); // exclut les chemins vides
}

// ----- Données de la page -----
const { article, related } = Astro.props;

// SEO
const metaTitle = article.seo?.metaTitle || article.title;
const metaDescription = article.seo?.metaDescription || article.excerpt || '';
const canonical = article.seo?.canonicalURL || '';
const ogImage = article.seo?.metaImage?.url
  ? mediaURL(article.seo.metaImage.url)
  : article.cover?.url
    ? mediaURL(article.cover.url)
    : undefined;

// Date affichée (date originale WP, pas la date de migration)
const publishedDate = article.originalPublishedAt
  ? new Date(article.originalPublishedAt).toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : undefined;

// Catégorie affichée : on prend la primaryCategory si dispo
const categoryName = article.primaryCategory?.name;

// Image de cover (avec alt + caption éventuels depuis Strapi)
const coverURL = article.cover?.url ? mediaURL(article.cover.url) : undefined;
const coverAlt = article.cover?.alternativeText || article.title || '';
const coverCaption = article.cover?.caption || undefined;

// Headings du contenu (pour le TOC sidebar gauche)
const headings = extractHeadings(article.content || []);

// Auteur (nom + rôle + bio + avatar résolu)
const authorName = article.author?.name;
const authorBio = article.author?.bio || undefined;
const authorAvatarURL = article.author?.avatar?.url
  ? mediaURL(article.author.avatar.url)
  : undefined;
const authorData = authorName
  ? {
      name: authorName,
      role: 'Rédacteur',
      bio: authorBio,
      avatarURL: authorAvatarURL,
    }
  : undefined;
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalURL={canonical || undefined}
  ogImage={ogImage}
  noindex={true}
>
  <Nav slot="nav" />

  <ArticleHero
    title={article.title}
    category={categoryName}
    date={publishedDate}
    author={authorName}
    authorRole="Rédacteur"
  />

  <ArticleBody
    excerpt={article.excerpt}
    cover={coverURL}
    coverAlt={coverAlt}
    coverCaption={coverCaption}
    headings={headings}
    author={authorData}
    related={related}
  >
    <BlocksRenderer blocks={article.content || []} />
  </ArticleBody>

  <Footer slot="footer" />
</BaseLayout>
