---
// src/pages/[...path].astro
// Catch-all qui sert SOIT une page article, SOIT une page catégorie selon le
// chemin demandé. Les deux types sont générés au build via getStaticPaths.

import {
  getAllArticles,
  getArticlePath,
  mediaURL,
  extractHeadings,
  getRelatedArticles,
  stripDuplicateLeadingParagraph,
  getCategoryTree,
  prettyCategoryName,
} from '../lib/strapi.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleHero from '../components/ArticleHero.astro';
import ArticleBody from '../components/ArticleBody.astro';
import BlocksRenderer from '../components/BlocksRenderer.astro';
import CategoryView from '../components/CategoryView.astro';

// ----- Génération des chemins statiques (SSG) -----
export async function getStaticPaths() {
  const articles = await getAllArticles();
  const categoryTree = getCategoryTree(articles);

  // 1) Pages d'article
  const articleEntries = articles
    .map((article) => {
      const fullPath = getArticlePath(article);
      const path = fullPath.replace(/^\/+/, '');
      const related = getRelatedArticles(article, articles, 3);
      return {
        params: { path },
        props: { kind: 'article', article, related },
      };
    })
    .filter((e) => e.params.path);

  // 2) Pages de catégorie (racines + sous-catégories)
  const categoryEntries = [...categoryTree.values()].map((cat) => {
    const path = cat.path.replace(/^\/+/, '');
    return {
      params: { path },
      props: { kind: 'category', category: cat },
    };
  }).filter((e) => e.params.path);

  // Si une catégorie partage exactement le même path qu'un article (cas
  // improbable mais à protéger), on garde la catégorie (la page article serait
  // un sous-segment de toute façon).
  const taken = new Set(categoryEntries.map((e) => e.params.path));
  const dedupedArticles = articleEntries.filter((e) => !taken.has(e.params.path));

  return [...categoryEntries, ...dedupedArticles];
}

// ----- Données de la page : on regarde le kind pour brancher l'affichage -----
const { kind } = Astro.props;
---

{kind === 'category' && (
  (() => {
    const { category } = Astro.props as { category: any };
    const catName = prettyCategoryName(category.slug);
    const metaTitle = `${catName} — Ponyscope`;
    const metaDescription = `Tous les articles Ponyscope dans la catégorie ${catName}.`;
    return (
      <BaseLayout
        title={metaTitle}
        description={metaDescription}
        noindex={true}
      >
        <Nav slot="nav" />
        <CategoryView category={category} />
        <Footer slot="footer" />
      </BaseLayout>
    );
  })()
)}

{kind === 'article' && (
  (() => {
    const { article, related } = Astro.props as { article: any; related: any[] };

    // SEO
    const metaTitle = article.seo?.metaTitle || article.title;
    const metaDescription = article.seo?.metaDescription || article.excerpt || '';
    const canonical = article.seo?.canonicalURL || '';
    const ogImage = article.seo?.metaImage?.url
      ? mediaURL(article.seo.metaImage.url)
      : article.cover?.url
        ? mediaURL(article.cover.url)
        : undefined;

    // Date affichée
    const publishedDate = article.originalPublishedAt
      ? new Date(article.originalPublishedAt).toLocaleDateString('fr-FR', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })
      : undefined;

    const categoryName = article.primaryCategory?.name;

    // Image de cover
    const coverURL = article.cover?.url ? mediaURL(article.cover.url) : undefined;
    const coverAlt = article.cover?.alternativeText || article.title || '';
    const coverCaption = article.cover?.caption || undefined;

    // Contenu : on enlève le 1er paragraphe s'il duplique le chapô
    const contentBlocks = stripDuplicateLeadingParagraph(
      article.content || [],
      article.excerpt || ''
    );

    // Headings (pour le TOC sidebar gauche)
    const headings = extractHeadings(contentBlocks);

    // Auteur
    const authorName = article.author?.name;
    const authorBio = article.author?.bio || undefined;
    const authorAvatarURL = article.author?.avatar?.url
      ? mediaURL(article.author.avatar.url)
      : undefined;
    const authorData = authorName
      ? {
          name: authorName,
          role: 'Rédacteur',
          bio: authorBio,
          avatarURL: authorAvatarURL,
        }
      : undefined;

    return (
      <BaseLayout
        title={metaTitle}
        description={metaDescription}
        canonicalURL={canonical || undefined}
        ogImage={ogImage}
        noindex={true}
      >
        <Nav slot="nav" />

        <ArticleHero
          title={article.title}
          category={categoryName}
          date={publishedDate}
        />

        <ArticleBody
          excerpt={article.excerpt}
          cover={coverURL}
          coverAlt={coverAlt}
          coverCaption={coverCaption}
          headings={headings}
          author={authorData}
          related={related}
        >
          <BlocksRenderer blocks={contentBlocks} />
        </ArticleBody>

        <Footer slot="footer" />
      </BaseLayout>
    );
  })()
)}
