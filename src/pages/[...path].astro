---
// src/pages/[...path].astro
// Template universel pour les articles Ponyscope.
// Au build, génère UNE page statique par article, à l'URL exacte du canonicalURL Strapi.

import { getAllArticles, getArticlePath, mediaURL } from '../lib/strapi.js';
import BlocksRenderer from '../components/BlocksRenderer.astro';

// ----- Génération des chemins statiques (SSG) -----
export async function getStaticPaths() {
  const articles = await getAllArticles();

  return articles
    .map((article) => {
      const fullPath = getArticlePath(article); // ex: "/blog/top-5-aquaponey"
      // Astro veut "path" sans le slash de tête pour [...path]
      const path = fullPath.replace(/^\/+/, '');

      return {
        params: { path },
        props: { article },
      };
    })
    .filter((entry) => entry.params.path); // exclut les chemins vides
}

// ----- Données de la page -----
const { article } = Astro.props;

// SEO
const metaTitle = article.seo?.metaTitle || article.title;
const metaDescription = article.seo?.metaDescription || article.excerpt || '';
// EN DEV : on force noindex (règle CLAUDE.md). En prod on respectera le metaRobots Strapi.
const metaRobots = 'noindex, nofollow';
const canonical = article.seo?.canonicalURL || '';
const ogImage = article.seo?.metaImage?.url
  ? mediaURL(article.seo.metaImage.url)
  : article.cover?.url
    ? mediaURL(article.cover.url)
    : null;

// Date affichée (date originale WP, pas la date de migration)
const publishedDate = article.originalPublishedAt
  ? new Date(article.originalPublishedAt).toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;

const author = article.author;
const cover = article.cover;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={metaRobots} />
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Open Graph */}
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Fonts minimalistes pour la lecture */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">Ponyscope</a>
      </div>
    </header>

    <main>
      <article class="post">
        {cover && (
          <div class="post-cover">
            <img
              src={mediaURL(cover.url)}
              alt={cover.alternativeText || article.title}
              width={cover.width}
              height={cover.height}
            />
          </div>
        )}

        <div class="container">
          <header class="post-header">
            <h1>{article.title}</h1>
            {article.excerpt && <p class="post-excerpt">{article.excerpt}</p>}
            <div class="post-meta">
              {author && <span class="author">par {author.name}</span>}
              {publishedDate && <span class="date">· {publishedDate}</span>}
            </div>
          </header>

          <div class="post-content">
            <BlocksRenderer blocks={article.content || []} />
          </div>
        </div>
      </article>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© Ponyscope · Média équestre français</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --navy: #10142F;
    --gold: #BF9B66;
    --paper: #FFFCF6;
    --text: #2a2a2a;
    --muted: #777;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--paper);
    color: var(--text);
    font-size: 17px;
    line-height: 1.65;
  }

  h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--navy);
    font-weight: 600;
  }
  h1 { font-size: 2.6rem; line-height: 1.15; }
  h2 { font-size: 1.9rem; }
  h3 { font-size: 1.4rem; }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .site-header {
    border-bottom: 1px solid #eee;
    padding: 1.2rem 0;
    background: white;
  }
  .site-header .logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    color: var(--navy);
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .post-cover {
    width: 100%;
    max-height: 60vh;
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-header {
    margin: 2rem 0 2.5rem;
    text-align: center;
  }
  .post-excerpt {
    font-size: 1.15rem;
    color: var(--muted);
    font-style: italic;
    margin: 1rem 0;
  }
  .post-meta {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .post-meta .author { color: var(--gold); font-weight: 500; }

  .post-content {
    margin-bottom: 4rem;
  }

  .site-footer {
    border-top: 1px solid #eee;
    padding: 2rem 0;
    background: white;
    text-align: center;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>