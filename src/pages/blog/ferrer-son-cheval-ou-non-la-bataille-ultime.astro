<script>
  // Reading progress
  window.addEventListener('scroll', () => {
    const h = document.documentElement;
    const scrolled = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
    document.getElementById('progress').style.width = scrolled + '%';
  });

  // TOC active state
  const headings = document.querySelectorAll('.article-main h2');
  const tocLinks = document.querySelectorAll('.toc a');
  window.addEventListener('scroll', () => {
    let current = '';
    headings.forEach(h => {
      const rect = h.getBoundingClientRect();
      if (rect.top < 250) current = h.id;
    });
    if (current) {
      tocLinks.forEach(a => {
        a.classList.toggle('active', a.getAttribute('href') === '#' + current);
      });
    }
  });

  // === STICKY-DEFERRED TOC ===
  // Comportement : la TOC scrolle normalement avec la page jusqu'à ce que
  // son BAS atteigne le bas du viewport, puis elle s'ancre. Quand on remonte
  // au-dessus de sa position initiale, elle revient en flux normal.
  // Si elle dépasse la hauteur de l'article, elle s'arrête au bas de l'article.
  (function() {
    const tocWrap = document.querySelector('.toc-wrap');
    const toc = document.getElementById('toc');
    if (!tocWrap || !toc) return;

    const MARGIN_BOTTOM = 30; // marge entre le bas de la TOC et le bas du viewport quand ancrée

    let wrapTop = 0;
    let wrapWidth = 0;
    let tocHeight = 0;
    let wrapHeight = 0;

    function measure() {
      // Reset pour mesurer en flux normal
      toc.classList.remove('is-pinned', 'is-bottom');
      toc.style.width = '';

      const wrapRect = tocWrap.getBoundingClientRect();
      wrapTop = wrapRect.top + window.scrollY;
      wrapWidth = tocWrap.offsetWidth;
      tocHeight = toc.offsetHeight;

      // Définir la hauteur du wrapper pour réserver l'espace
      tocWrap.style.minHeight = tocHeight + 'px';
      wrapHeight = tocWrap.parentElement.offsetHeight;

      toc.style.setProperty('--toc-width', wrapWidth + 'px');
    }

    function update() {
      const scrollY = window.scrollY;
      const vh = window.innerHeight;

      // Seuil : quand le bas de la TOC (en flux normal) atteint le bas du viewport
      // En flux normal, bas de la TOC = wrapTop + tocHeight
      // On veut que le bas de la TOC = scrollY + vh - MARGIN_BOTTOM
      // Donc on ancre quand : wrapTop + tocHeight <= scrollY + vh - MARGIN_BOTTOM
      // Soit : scrollY >= wrapTop + tocHeight - vh + MARGIN_BOTTOM

      const pinThreshold = wrapTop + tocHeight - vh + MARGIN_BOTTOM;

      // Limite basse : la TOC ne doit pas dépasser le bas du conteneur parent (article)
      const parentRect = tocWrap.parentElement.getBoundingClientRect();
      const parentBottom = parentRect.bottom + scrollY;
      const stopThreshold = parentBottom - tocHeight;

      if (scrollY < pinThreshold) {
        // En flux normal
        toc.classList.remove('is-pinned', 'is-bottom');
        toc.style.top = '';
      } else if (scrollY >= stopThreshold) {
        // On a atteint le bas du conteneur : la TOC s'arrête en absolu
        toc.classList.remove('is-pinned');
        toc.classList.add('is-bottom');
        toc.style.top = '';
      } else {
        // Ancrée : fixée en bas du viewport
        toc.classList.add('is-pinned');
        toc.classList.remove('is-bottom');
        toc.style.top = (vh - tocHeight - MARGIN_BOTTOM) + 'px';
      }
    }

    // Setup
    measure();
    update();

    // Listeners
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      update();
    });
  })();
</script>

</body>
</html>
