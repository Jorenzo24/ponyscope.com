---
// src/pages/index.astro
// Page d'accueil v1 — pas la version finale (à designer ensemble plus tard),
// juste une home cohérente avec le design system : hero éditorial + grille
// des 12 derniers articles. Utilise BaseLayout pour hériter du favicon, des
// fonts et du noindex.

import { getAllArticles } from '../lib/strapi.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrnamentDivider from '../components/OrnamentDivider.astro';
import CategoryCard from '../components/CategoryCard.astro';

// Récupère les articles, trie par date desc, prend les 12 premiers
const all = await getAllArticles();
const sorted = [...all].sort((a, b) => {
  const da = new Date(a.originalPublishedAt || a.publishedAt || 0).getTime();
  const db = new Date(b.originalPublishedAt || b.publishedAt || 0).getTime();
  return db - da;
});
const recents = sorted.slice(0, 12);
---

<BaseLayout
  title="Ponyscope — Le média des cavaliers curieux"
  description="Tops, tutos, guides, éthologie : tout l'univers équestre avec ce qu'il faut de sérieux et ce qu'il faut de panache."
  noindex={true}
>
  <Nav slot="nav" />

  <header class="home-hero">
    <div class="home-hero-veil"></div>
    <div class="home-hero-content">
      <span class="home-eyebrow">Le média des cavaliers curieux</span>
      <h1 class="home-title">Ponyscope</h1>
      <OrnamentDivider symbol="✦" width="64px" variant="gold-soft" marginY="0" />
      <p class="home-tagline">
        Tops, tutos, portraits, éthologie, métiers — l'univers équestre,
        relu et raconté pour ceux qui montent <em>vraiment</em>.
      </p>
    </div>
  </header>

  <section class="home-recent">
    <div class="home-recent-head">
      <span class="home-section-label">À la une</span>
      <h2 class="home-section-title">Les derniers articles</h2>
    </div>
    <div class="home-grid">
      {recents.map((article) => <CategoryCard article={article} />)}
    </div>
    <div class="home-cta">
      <a href="/blog" class="home-cta-link">Voir tous les articles ↗</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* === Hero === */
  .home-hero {
    position: relative;
    min-height: 78vh;
    max-height: 880px;
    background:
      radial-gradient(
        ellipse 120% 80% at center,
        transparent 0%,
        rgba(8, 10, 31, 0.55) 100%
      ),
      var(--navy);
    color: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 100px 24px;
  }
  .home-hero-veil {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      100deg,
      rgba(255, 255, 255, 0.012) 0 1px,
      transparent 1px 3px
    );
    pointer-events: none;
  }
  .home-hero-content {
    position: relative;
    z-index: 1;
    max-width: 920px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }

  .home-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    color: rgba(250, 246, 238, 0.65);
    font-weight: 500;
  }

  .home-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(72px, 12vw, 180px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--paper);
    margin: 0;
  }

  .home-tagline {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2vw, 22px);
    font-style: italic;
    line-height: 1.55;
    color: rgba(250, 246, 238, 0.78);
    max-width: 640px;
    margin: 0;
    letter-spacing: 0.01em;
  }
  .home-tagline em {
    color: var(--gold-soft);
    font-style: italic;
  }

  /* === Section "À la une" === */
  .home-recent {
    background: var(--ivory);
    padding: 110px 32px 120px;
  }
  .home-recent-head {
    max-width: 1480px;
    margin: 0 auto 60px;
    text-align: center;
  }
  .home-section-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 18px;
  }
  .home-section-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.1;
    color: var(--navy);
    margin: 0;
    letter-spacing: -0.018em;
  }

  .home-grid {
    max-width: 1480px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 44px;
  }

  .home-cta {
    text-align: center;
    margin-top: 80px;
  }
  .home-cta-link {
    font-family: var(--font-sans);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding: 8px 0;
    font-weight: 500;
    transition: color 0.2s, border-color 0.2s;
  }
  .home-cta-link:hover {
    color: var(--gold-deep);
    border-bottom-color: var(--gold-deep);
  }

  @media (max-width: 1099px) {
    .home-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 32px;
    }
  }
  @media (max-width: 640px) {
    .home-hero { min-height: 62vh; padding: 80px 20px; }
    .home-hero-content { gap: 26px; }
    .home-recent { padding: 70px 16px 80px; }
    .home-recent-head { margin-bottom: 44px; }
    .home-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .home-cta { margin-top: 56px; }
  }
</style>
