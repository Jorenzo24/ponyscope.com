---
// src/pages/index.astro
// Page d'accueil v1 — pas la version finale (à designer ensemble plus tard),
// juste une home cohérente avec le design system : hero éditorial + grille
// des 12 derniers articles. Utilise BaseLayout pour hériter du favicon, des
// fonts et du noindex.

import { getAllArticles, getCategoryTree, mediaURL } from '../lib/strapi.js';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrnamentDivider from '../components/OrnamentDivider.astro';
import CategoryCard from '../components/CategoryCard.astro';

// Récupère les articles, trie par date desc, prend les 12 premiers
const all = await getAllArticles();
const sorted = [...all].sort((a, b) => {
  const da = new Date(a.originalPublishedAt || a.publishedAt || 0).getTime();
  const db = new Date(b.originalPublishedAt || b.publishedAt || 0).getTime();
  return db - da;
});
const recents = sorted.slice(0, 12);

// --- Vitrine des rubriques ---
// On dérive tout de getCategoryTree() (path, nb d'articles, cover de l'article
// le plus récent). Ordre + libellés calés sur la Nav. Les intros sont reprises
// de CategoryView (clé = path d'URL ici). Une rubrique absente du tree ou vide
// est simplement ignorée → pas de tuile fantôme.
const tree = getCategoryTree(all);
// `size` pilote la mosaïque : 'feature' (2×2), 'wide' (2×1), 'small' (1×1).
// Total des cellules = 4 + 2+2+2 + 1+1 = 12 = 3 rangées de 4 colonnes (pavage plein).
const RUBRIQUES = [
  { path: '/blog',          label: 'Le Blog',       size: 'feature', intro: 'Tout l’univers équestre, au fil des jours.' },
  { path: '/tops',          label: 'Tops',          size: 'wide',    intro: 'Le meilleur et le pire de la vie de cavalier, en listes.' },
  { path: '/tutos',         label: 'Tutos',         size: 'small',   intro: 'On retrousse les manches : le geste juste, expliqué simplement.' },
  { path: '/guides-galops', label: 'Guides Galops', size: 'small',   intro: 'Pour progresser, du premier galop au dernier obstacle.' },
  { path: '/metiers',       label: 'Métiers',       size: 'wide',    intro: 'Celles et ceux qui font tourner le monde du cheval.' },
  { path: '/ethologie',     label: 'Éthologie',     size: 'wide',    intro: 'Comprendre le cheval avant de vouloir le monter.' },
];

function rubriqueCover(cat: any) {
  const cover = cat?.articles?.[0]?.cover;
  if (!cover) return undefined;
  const c = cover.formats?.medium?.url || cover.formats?.small?.url || cover.url;
  return c ? mediaURL(c) : undefined;
}

const rubriques = RUBRIQUES
  .map((r) => {
    const cat = tree.get(r.path);
    if (!cat || !cat.articles.length) return null;
    return { ...r, count: cat.articles.length, cover: rubriqueCover(cat) };
  })
  .filter((r): r is NonNullable<typeof r> => r !== null);
---

<BaseLayout
  title="Ponyscope — Le média des cavaliers curieux"
  description="Tops, tutos, guides, éthologie : tout l'univers équestre avec ce qu'il faut de sérieux et ce qu'il faut de panache."
  noindex={true}
>
  <Nav slot="nav" />

  <header class="home-hero">
    <div class="home-hero-veil"></div>
    <div class="home-hero-content">
      <span class="home-eyebrow">Le média des cavaliers curieux</span>
      <h1 class="home-title">Ponyscope</h1>
      <OrnamentDivider symbol="✦" width="64px" variant="gold-soft" marginY="0" />
      <p class="home-tagline">
        Tops, tutos, portraits, éthologie, métiers — l'univers équestre,
        relu et raconté pour ceux qui montent <em>vraiment</em>.
      </p>
    </div>
  </header>

  <section class="home-rubriques">
    <div class="home-rubriques-head">
      <span class="home-section-label">Explorer</span>
      <h2 class="home-section-title">Les rubriques</h2>
    </div>
    <div class="rubriques-grid">
      {rubriques.map((r) => (
        <a class={`rubrique rubrique--${r.size}`} href={r.path}>
          {r.cover ? (
            <img class="rubrique-img" src={r.cover} alt="" loading="lazy" />
          ) : (
            <span class="rubrique-img rubrique-img--empty" aria-hidden="true"></span>
          )}
          <span class="rubrique-shade" aria-hidden="true"></span>
          <span class="rubrique-content">
            <span class="rubrique-kicker">Rubrique</span>
            <h3 class="rubrique-name">{r.label}</h3>
            {r.size === 'feature' && <span class="rubrique-intro">{r.intro}</span>}
            <span class="rubrique-count">{r.count} article{r.count > 1 ? 's' : ''} <span class="rubrique-arrow">→</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-recent">
    <div class="home-recent-head">
      <span class="home-section-label">À la une</span>
      <h2 class="home-section-title">Les derniers articles</h2>
    </div>
    <div class="home-grid">
      {recents.map((article) => <CategoryCard article={article} />)}
    </div>
    <div class="home-cta">
      <a href="/blog" class="home-cta-link">Voir tous les articles ↗</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* === Hero === */
  .home-hero {
    position: relative;
    min-height: 78vh;
    max-height: 880px;
    background:
      radial-gradient(
        ellipse 120% 80% at center,
        transparent 0%,
        rgba(8, 10, 31, 0.55) 100%
      ),
      var(--navy);
    color: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 100px 24px;
  }
  .home-hero-veil {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      100deg,
      rgba(255, 255, 255, 0.012) 0 1px,
      transparent 1px 3px
    );
    pointer-events: none;
  }
  .home-hero-content {
    position: relative;
    z-index: 1;
    max-width: 920px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }

  .home-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    color: rgba(250, 246, 238, 0.65);
    font-weight: 500;
  }

  .home-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(72px, 12vw, 180px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    color: var(--paper);
    margin: 0;
  }

  .home-tagline {
    font-family: var(--font-serif);
    font-size: clamp(18px, 2vw, 22px);
    font-style: italic;
    line-height: 1.55;
    color: rgba(250, 246, 238, 0.78);
    max-width: 640px;
    margin: 0;
    letter-spacing: 0.01em;
  }
  .home-tagline em {
    color: var(--gold-soft);
    font-style: italic;
  }

  /* === Section "Les rubriques" (vitrine) === */
  .home-rubriques {
    background: var(--paper);
    padding: 104px 32px 36px;
  }
  .home-rubriques-head {
    max-width: 1480px;
    margin: 0 auto 56px;
    text-align: center;
  }
  /* Mosaïque "bento" : pavage de blocs de tailles différentes, façon vitrine
     e-commerce. Pavage plein 4 colonnes (cf. commentaire sur RUBRIQUES). */
  .rubriques-grid {
    max-width: 1480px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 212px;
    grid-auto-flow: dense;
    gap: 16px;
  }
  .rubrique--feature { grid-column: span 2; grid-row: span 2; }
  .rubrique--wide    { grid-column: span 2; grid-row: span 1; }
  .rubrique--small   { grid-column: span 1; grid-row: span 1; }

  .rubrique {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    text-decoration: none;
    background: var(--navy);
    isolation: isolate;
  }
  /* Liseré or qui apparaît au survol (inset, ne bouge pas le layout). */
  .rubrique::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 1px solid transparent;
    border-radius: 4px;
    pointer-events: none;
    transition: border-color 0.3s ease;
  }
  .rubrique:hover::after { border-color: var(--gold-soft); }

  .rubrique-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.06) contrast(1.02) brightness(0.92);
    transition: transform 0.6s ease;
  }
  .rubrique:hover .rubrique-img { transform: scale(1.06); }
  .rubrique-img--empty {
    background: linear-gradient(135deg, var(--navy), #1c2348);
  }

  /* Voile chaud (espresso) pour lisibilité du texte clair par-dessus. */
  .rubrique-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(14, 10, 5, 0.84) 0%,
      rgba(14, 10, 5, 0.40) 40%,
      rgba(14, 10, 5, 0.08) 72%,
      transparent 100%
    );
    transition: opacity 0.3s ease;
  }

  .rubrique-content {
    position: relative;
    z-index: 1;
    height: 100%;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 5px;
    color: var(--paper);
  }
  .rubrique-kicker {
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-weight: 600;
    color: var(--gold-soft);
  }
  .rubrique-name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.0;
    letter-spacing: -0.015em;
    color: var(--paper);
    margin: 0;
  }
  .rubrique--feature .rubrique-name {
    font-size: clamp(36px, 4.2vw, 58px);
  }
  .rubrique-intro {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.45;
    color: rgba(250, 246, 238, 0.86);
    max-width: 28ch;
    margin-top: 2px;
  }
  .rubrique-count {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    color: rgba(250, 246, 238, 0.80);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }
  .rubrique-arrow { transition: transform 0.25s ease; }
  .rubrique:hover .rubrique-arrow { transform: translateX(4px); }

  /* Tablette : 2 colonnes. La vedette occupe la pleine largeur (2×2), les
     "wide" la pleine largeur en hauteur simple, les "small" en demi. */
  @media (max-width: 1099px) {
    .rubriques-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 200px;
    }
    .rubrique--feature { grid-column: span 2; grid-row: span 2; }
    .rubrique--wide    { grid-column: span 2; grid-row: span 1; }
    .rubrique--small   { grid-column: span 1; grid-row: span 1; }
  }
  @media (max-width: 640px) {
    .home-rubriques { padding: 66px 14px 24px; }
    .home-rubriques-head { margin-bottom: 40px; }
    .rubriques-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 168px;
      gap: 14px;
    }
    .rubrique--feature { grid-column: span 1; grid-row: span 2; }
    .rubrique--wide    { grid-column: span 1; grid-row: span 1; }
    .rubrique--small   { grid-column: span 1; grid-row: span 1; }
  }

  /* === Section "À la une" === */
  .home-recent {
    background: var(--ivory);
    padding: 110px 32px 120px;
  }
  .home-recent-head {
    max-width: 1480px;
    margin: 0 auto 60px;
    text-align: center;
  }
  .home-section-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 18px;
  }
  .home-section-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.1;
    color: var(--navy);
    margin: 0;
    letter-spacing: -0.018em;
  }

  .home-grid {
    max-width: 1480px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 44px;
  }

  .home-cta {
    text-align: center;
    margin-top: 80px;
  }
  .home-cta-link {
    font-family: var(--font-sans);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--gold);
    padding: 8px 0;
    font-weight: 500;
    transition: color 0.2s, border-color 0.2s;
  }
  .home-cta-link:hover {
    color: var(--gold-deep);
    border-bottom-color: var(--gold-deep);
  }

  @media (max-width: 1099px) {
    .home-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px 32px;
    }
  }
  @media (max-width: 640px) {
    .home-hero { min-height: 62vh; padding: 80px 20px; }
    .home-hero-content { gap: 26px; }
    .home-recent { padding: 70px 16px 80px; }
    .home-recent-head { margin-bottom: 44px; }
    .home-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .home-cta { margin-top: 56px; }
  }
</style>
