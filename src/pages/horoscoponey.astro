---
// src/pages/horoscoponey.astro
// Page dédiée Horoscoponey — l'horoscope parodique des cavaliers.
// Les 12 signes en grille, chacun avec sa "prédiction du jour" + jauges.
//
// SSG pur : le HTML est pré-généré au build avec une prédiction de repli
// (déterministe par signe → crawlable, pas de flash vide). Un petit JS client
// remplace ensuite par la prédiction DU JOUR (hash de date+signe) : ça paraît
// vivant, sans aucun backend ni rebuild.

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrnamentDivider from '../components/OrnamentDivider.astro';
import { SIGNS, GAUGES, PREDICTIONS } from '../data/horoscoponey.js';
import { signImage } from '../lib/signImages.js';

// Repli build-time : une prédiction stable par signe (sera écrasée par le JS
// avec celle du jour). On décale par l'index pour ne pas afficher 12× la même.
const fallback = (i: number) => PREDICTIONS[i % PREDICTIONS.length];
---

<BaseLayout
  title="Horoscoponey — l'horoscope des cavaliers"
  description="Ton signe, ton cheval, ton destin (plus ou moins). L'horoscope équestre parodique de Ponyscope, mis à jour chaque jour."
  noindex={true}
>
  <Nav slot="nav" />

  <header class="horo-hero">
    <div class="horo-hero-content">
      <span class="horo-eyebrow">Les astres, version sabots</span>
      <h1 class="horo-title">Horoscoponey</h1>
      <OrnamentDivider symbol="✦" width="64px" variant="gold-soft" marginY="0" />
      <p class="horo-tagline">
        Ton signe, ton cheval, ton destin — plus ou moins.
        Une prédiction par jour, à prendre au troisième degré (galop compris).
      </p>
      <span class="horo-today" data-today>Prédictions du jour</span>
    </div>
  </header>

  <section class="horo-section">
    <div class="horo-grid">
      {SIGNS.map((s, i) => {
        const illu = signImage(s.slug) as ImageMetadata | null;
        return (
        <article class="sign" data-sign={s.slug}>
          <div class="sign-head">
            {illu ? (
              <Image class="sign-illu" src={illu} alt={`Signe ${s.name}`} widths={[120, 180]} sizes="92px" loading="lazy" />
            ) : (
              <span class="sign-glyph" aria-hidden="true">{s.glyph}</span>
            )}
            <div class="sign-id">
              <h2 class="sign-name">{s.name}</h2>
              <span class="sign-dates">{s.dates}</span>
            </div>
          </div>

          <p class="sign-archetype">{s.archetype}</p>

          <div class="sign-divider" aria-hidden="true"></div>

          <p class="sign-pred">
            <span class="sign-pred-label">Ta journée</span>
            <span data-pred>{fallback(i)}</span>
          </p>

          <div class="sign-gauges">
            {GAUGES.map((g) => (
              <div class="gauge" data-gauge={g.key}>
                <span class="gauge-label">{g.label}</span>
                <span class="gauge-track"><span class="gauge-fill"></span></span>
                <span class="gauge-val">··</span>
              </div>
            ))}
          </div>
        </article>
        );
      })}
    </div>

    <p class="horo-foot">
      Horoscoponey est une rubrique parodique. Aucun cheval n’a été consulté
      pour l’établissement de ces prédictions.
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script is:inline define:vars={{ PREDICTIONS, GAUGES }}>
  // Hash déterministe (FNV-1a) → même tirage pour tous, un jour donné.
  function hashStr(s) {
    let h = 2166136261;
    for (let i = 0; i < s.length; i++) {
      h ^= s.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return h >>> 0;
  }

  const d = new Date();
  const dayKey = `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;

  // Label "du jour" lisible
  const todayEl = document.querySelector('[data-today]');
  if (todayEl) {
    const fmt = d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
    todayEl.textContent = `Prédictions du ${fmt}`;
  }

  document.querySelectorAll('[data-sign]').forEach((el) => {
    const slug = el.getAttribute('data-sign');

    // Prédiction du jour
    const predIdx = hashStr(`${dayKey}::pred::${slug}`) % PREDICTIONS.length;
    const predEl = el.querySelector('[data-pred]');
    if (predEl) predEl.textContent = PREDICTIONS[predIdx];

    // Jauges du jour
    GAUGES.forEach((g) => {
      const v = hashStr(`${dayKey}::${g.key}::${slug}`) % 101;
      const gEl = el.querySelector(`[data-gauge="${g.key}"]`);
      if (!gEl) return;
      const fill = gEl.querySelector('.gauge-fill');
      const val = gEl.querySelector('.gauge-val');
      if (fill) requestAnimationFrame(() => { fill.style.width = v + '%'; });
      if (val) val.textContent = v + '%';
    });
  });
</script>

<style>
  /* === Hero === */
  .horo-hero {
    position: relative;
    background:
      radial-gradient(ellipse 120% 90% at center, transparent 0%, rgba(8, 10, 31, 0.5) 100%),
      var(--navy);
    color: var(--paper);
    text-align: center;
    padding: 110px 24px 96px;
    overflow: hidden;
  }
  .horo-hero-content {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }
  .horo-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    color: rgba(250, 246, 238, 0.65);
    font-weight: 500;
  }
  .horo-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(54px, 9vw, 116px);
    line-height: 0.94;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--paper);
  }
  .horo-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.55;
    color: rgba(250, 246, 238, 0.82);
    max-width: 560px;
    margin: 0;
  }
  .horo-today {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 600;
    color: var(--gold-soft);
    border: 1px solid rgba(191, 155, 102, 0.4);
    border-radius: 999px;
    padding: 9px 20px;
  }

  /* === Grille des signes === */
  .horo-section {
    background: var(--ivory);
    padding: 90px 32px 110px;
  }
  .horo-grid {
    max-width: 1480px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .sign {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 28px 30px 30px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 14px 36px -26px rgba(60, 42, 24, 0.5);
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
  }
  .sign:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 48px -26px rgba(60, 42, 24, 0.6);
    border-color: var(--gold-soft);
  }

  .sign-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .sign-glyph {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    font-size: 28px;
    color: var(--gold-deep);
    background: var(--ivory);
    border: 1px solid var(--gold-soft);
    border-radius: 50%;
  }
  .sign-illu {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--gold-soft);
    background: var(--ivory);
  }
  .sign-name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--navy);
    margin: 0 0 5px;
  }
  .sign-dates {
    font-family: var(--font-sans);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .sign-archetype {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-mid);
    margin: 18px 0 0;
  }

  .sign-divider {
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold-soft), transparent);
    margin: 20px 0;
  }

  .sign-pred {
    margin: 0;
    flex: 1;
  }
  .sign-pred-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-weight: 600;
    color: var(--gold-deep);
    margin-bottom: 9px;
  }
  .sign-pred [data-pred],
  .sign-pred span[data-pred] {
    font-family: var(--font-serif);
    font-size: 18.5px;
    line-height: 1.5;
    color: var(--navy);
  }

  .sign-gauges {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .gauge {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4px 12px;
  }
  .gauge-label {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mid);
    font-weight: 500;
  }
  .gauge-val {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--gold-deep);
    font-variant-numeric: tabular-nums;
  }
  .gauge-track {
    grid-column: 1 / -1;
    height: 5px;
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow: hidden;
  }
  .gauge-fill {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(to right, var(--gold-soft), var(--gold-deep));
    border-radius: 999px;
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .horo-foot {
    max-width: 1480px;
    margin: 56px auto 0;
    text-align: center;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 13.5px;
    color: var(--ink-soft);
  }

  @media (max-width: 1099px) {
    .horo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .horo-hero { padding: 80px 18px 70px; }
    .horo-section { padding: 64px 14px 80px; }
    .horo-grid { grid-template-columns: 1fr; gap: 22px; }
  }
</style>
